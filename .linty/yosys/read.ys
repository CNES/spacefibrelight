verific  -work phy_plus_lane_lib -vhdl src/module_phy_plus_lane/phy_plus_lane.vhd
verific  -work phy_plus_lane_lib -vhdl src/module_phy_plus_lane/mib_phy_plus_lane.vhd

#lane layer for NGULTRA
