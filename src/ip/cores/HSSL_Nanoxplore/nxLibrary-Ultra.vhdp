			    , DRDN  => GVDN
			    , DRA   => GPA
			    , DRI   => DRI
			    , FA    => DRA
			--  , FZ
			--  , ALD
			--  , ALT
			    , DRO   => DRO
			    , DID   => DID
			--  , FLD
			--  , FLG
			    , LINK  => LINK
		   );
-- U  ----------------------------------------------------------------------------------------------
end generate;
-- #}}}#

end NX_RTL;
