attribute syn_preserve : boolean;
attribute syn_preserve of inst_pll_u : label is true;

begin 

inst_pll_u : NX_PLL_U_BOX
generic map (
  location                        => location&":PLL.PLL1"

  ,cfg_use_pll                     => CFG_BANK(0)
  ,cfg_pll_odf                     => CFG_BANK(2 downto 1)
  ,cfg_pll_cpump                   => CFG_BANK(6 downto 3)
  ,cfg_pll_lpf_res                 => CFG_BANK(10 downto 7)
  ,cfg_pll_lpf_cap                 => CFG_BANK(14 downto 11)
  ,cfg_pll_lock                    => CFG_BANK(18 downto 15)
  ,cfg_pll_ldf_div_ratio           => CFG_BANK(25 downto 19)
  ,cfg_pll_clk_ref_div_ratio       => CFG_BANK(30 downto 26)
  ,cfg_pll_clk_ref_mux             => "101" -- connect to clock_fabric_i(0)
  ,cfg_pll_clk_fb_mux              => "111" -- connect to clock_fabric_i(0) in FB
  ,cfg_pll_clk_fb_add_delay        => CFG_BANK(37)
  ,cfg_dly_val_feedback            => CFG_BANK(43 downto 38)
  ,cfg_pll_clk_div_ratio_0         => CFG_BANK(46 downto 44)
  ,cfg_pll_clk_div_ratio_1         => CFG_BANK(49 downto 47)
  ,cfg_pll_clk_div_ratio_2         => CFG_BANK(52 downto 50)
  ,cfg_pll_clk_div_ratio_3         => CFG_BANK(55 downto 53)
  ,cfg_pll_clk_div_dyn_ratio_0     => CFG_BANK(59 downto 56)
  ,cfg_pll_clk_div_dyn_ratio_1     => CFG_BANK(63 downto 60)
  ,cfg_pll_clk_div_dyn_ratio_2     => CFG_BANK(67 downto 64)
  ,cfg_pll_clk_div_dyn_ratio_3     => CFG_BANK(71 downto 68)
  ,cfg_pll_clk_div_dyn_ratio_4     => CFG_BANK(75 downto 72)
  ,cfg_use_cal                     => CFG_BANK(76)
  ,cfg_clk_cal_mux                 => "10"--CFG_BANK(78 downto 77)
  ,cfg_clk_cal_div_ratio           => CFG_BANK(82 downto 79)
  ,cfg_dly_val_calibration         => CFG_BANK(88 downto 83)
  ,cfg_test_mode                   => CFG_BANK(90 downto 89)
  --
  --,cfg_wvf_en                      => CFG_WVF(0)
  --,cfg_wvf_clk_mux                 => CFG_WVF(5 downto 1)
  --,cfg_wvf_clk_inv                 => CFG_WVF(6)
  --,cfg_wvf_sync_mux                => CFG_WVF(10 downto 7)
  --,cfg_wvf_sync_use_arst_n         => CFG_WVF(11)
  --,cfg_wvf_sync_use_pll_lock       => CFG_WVF(12)
  --,cfg_wvf_sync_use_pll_locka      => CFG_WVF(13)
  --,cfg_wvf_sync_use_cal_lock       => CFG_WVF(14)
  --,cfg_wvf_pattern                 => CFG_WVF(30 downto 15)
  --,cfg_wvf_pattern_len_max         => CFG_WVF(34 downto 31)
  --,cfg_wvf_add_delay               => CFG_WVF(35)
  --,cfg_dly_val_waveform            => CFG_WVF(41 downto 36)
)
port map (
  R                  => arst_pll_i
  ,REF               => clk_pll_ref
  ,FBK               => clk_pll_fb
  -- Clock
  ,OSC               => clk_osc_i
  ,VCO               => clk_pll
  ,LDFO              => clk_pll_ldf_div
  ,REFO              => clk_pll_ref_div
  ,CLK_DIV1          => clk_pll_div(0)
  ,CLK_DIV2          => clk_pll_div(1)
  ,CLK_DIV3          => clk_pll_div(2)
  ,CLK_DIV4          => clk_pll_div(3)
  ,CLK_DIVD1         => clk_pll_div_dyn(0)
  ,CLK_DIVD2         => clk_pll_div_dyn(1)
  ,CLK_DIVD3         => clk_pll_div_dyn(2)
  ,CLK_DIVD4         => clk_pll_div_dyn(3)
  ,CLK_DIVD5         => clk_pll_div_dyn(4)
  -- Lock engine
  ,PLL_LOCKED        => pll_lock_o
  ,PLL_LOCKEDA       => pll_locka_o
  -- Calbration
  ,ARST_CAL          => arst_cal_i
  ,CLK_CAL           => clk_cal
  ,CLK_CAL_DIV       => clk_cal_div
  ,CAL_LOCKED        => cal_lock_o
  ,EXT_CAL_LOCKED    => ext_cal_lock_i
  ,CAL1              => ext_calibration_o(0)
  ,CAL2              => ext_calibration_o(1)
  ,CAL3              => ext_calibration_o(2)
  ,CAL4              => ext_calibration_o(3)
  ,CAL5              => ext_calibration_o(4)
  ,EXT_CAL1          => ext_calibration_i(0)
  ,EXT_CAL2          => ext_calibration_i(1)
  ,EXT_CAL3          => ext_calibration_i(2)
  ,EXT_CAL4          => ext_calibration_i(3)
  ,EXT_CAL5          => ext_calibration_i(4)
  ,DYN_CFG_EN        => dyn_cfg_en_i
  ,DYN_CFG_CS_N1     => dyn_cfg_cs_n_i(0)
  ,DYN_CFG_CS_N2     => dyn_cfg_cs_n_i(1)
  ,DYN_CFG_CS_N3     => dyn_cfg_cs_n_i(2)
  ,DYN_CFG_WE_N      => dyn_cfg_we_n_i
  ,DYN_CFG_ADDR1     => dyn_cfg_addr_i(0)
  ,DYN_CFG_ADDR2     => dyn_cfg_addr_i(1)
  ,DYN_CFG_ADDR3     => dyn_cfg_addr_i(2)
  ,DYN_CFG_ADDR4     => dyn_cfg_addr_i(3)
  ,DYN_CFG_WDATA_SEL => dyn_cfg_wdata_sel_i
  ,DYN_CFG_WDATA1    => dyn_cfg_wdata_i(0)
  ,DYN_CFG_WDATA2    => dyn_cfg_wdata_i(1)
  ,DYN_CFG_WDATA3    => dyn_cfg_wdata_i(2)
  ,DYN_CFG_WDATA4    => dyn_cfg_wdata_i(3)
  ,DYN_CFG_WDATA5    => dyn_cfg_wdata_i(4)
  ,DYN_CFG_WDATA6    => dyn_cfg_wdata_i(5)
  ,DYN_CFG_WDATA7    => dyn_cfg_wdata_i(6)
  ,DYN_CFG_RDATA1    => dyn_cfg_rdata_o(0)
  ,DYN_CFG_RDATA2    => dyn_cfg_rdata_o(1)
  ,DYN_CFG_RDATA3    => dyn_cfg_rdata_o(2)
  ,DYN_CFG_RDATA4    => dyn_cfg_rdata_o(3)
  ,DYN_CFG_RDATA5    => dyn_cfg_rdata_o(4)
  ,DYN_CFG_RDATA6    => dyn_cfg_rdata_o(5)
  ,DYN_CFG_RDATA7    => dyn_cfg_rdata_o(6)
  --scan interface
  ,scan_en_i         => scan_en_i
  ,scan_in_i1        => scan_in_i(0)
