    --
    -- constant raw_config1 : bit_vector(23 downto 0) := "000000000000100000010001";
    --                                                   "000000010000100000010001";
    --                                                  1 0                         bypass we dff                     (we_pr)
    --                                                  2  0                        bypass wez dff                   (wez_pr)
    --                                                  3   0                       bypass rst dff                   (rst_pr)
    --                                                  4    0                      bypass rstz dff                 (rstz_pr)
    --                                                  5     0                     bypass ovf dff                   (ovf_pr)
    --                                                  6      0                    bypass carry output dff          (cyo_pr)
    --                                                  7       0                   bypass cascade carry output dff (ccyo_pr)
    --                                                  8        0                  bypass Z output dff                (z_pr)
    --                                                  9         0                 bypass cascade Z output dff       (cz_pr)
    --                                                 10          0                bypass Y dff                       (y_pr)
    --                                                 11           0               bypass X dff                       (x_pr)
    --                                                 12            0              bypass carry input dff           (cyi_pr)
    --                                                 13             0             bypass multiplier dff              (m_pr)
    --                                                 14              0            bypass pre-adder dff               (p_pr)
    --                                                 15               0           bypass input D dff                 (d_pr)
    --                                                 16                0          bypass input C dff                 (c_pr)
    --                                                 17                 00        X0->bypass ; 01->1dff ; 11->2dff cascade output B
    --                                                 18                   00      X0->bypass ; 01->1dff ; 11->2dff B
    --                                                 19                     00    X0->bypass ; 01->1dff ; 11->2dff cascade output A
    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        variable config : bit_vector(23 downto 0) := "000000000000001100000000";
    begin
        --return stage0;-- or MASK_DSP_STAGE_1_TRUE or MASK_DSP_STAGE_2_TRUE or MASK_DSP_STAGE_3_TRUE;
        if STAGE_1 = true then
            config:= config or MASK_DSP_STAGE_1_TRUE;
        end if;
        if STAGE_2 = true then
            config:= config or MASK_DSP_STAGE_2_TRUE;
        end if;
        if STAGE_3 = true then
            config:= config or MASK_DSP_STAGE_3_TRUE;
        end if;
        return config;
    end function;

    function raw_config1_1 return bit_vector is
        variable config : bit_vector(23 downto 0) := "000000000000000100000000";
    begin
        if STAGE_1 = true then
            config:= config or MASK_DSP_STAGE_1_TRUE;
        end if;
        if STAGE_2 = true then
            config:= config or MASK_DSP_STAGE_2_TRUE;
        end if;
        if STAGE_3 = true then
            config:= config or MASK_DSP_STAGE_3_TRUE;
        end if;
        return config;
    end function;
    --
    -- constant raw_config2 : bit_vector(13 downto 0) := "00000100000011";
    --                                                   "00010100000011";
    --                                                 19 1               enable ovf reset                        (ovf_pr)
    --                                                 20  1              enable carry out reset                  (cyo_pr)
    --                                                 21   1             enable cascade carry out reset         (ccyo_pr)
    --                                                 22    1            enable Z out reset                        (z_pr)
    --                                                 23     1           enable cascade Z output/loopback reset   (cz_pr)
    --                                                 27      1          enable multiplier output reset            (m_pr)
    --                                                 24       1         enable Y reset                            (y_pr)
    --                                                 25        1        enable X reset                            (x_pr)
    --                                                 28         1       enable pre-adder output reset             (p_pr)
    --                                                 26          1      enable carry input reset                (cyi_pr)
    --                                                 29           1     enable D dff reset                        (d_pr)
    --                                                 30            1    enable C dff reset                        (c_pr)
    --                                                 31             1   enable B dff reset                        (b_pr)
    --                                                 32              1  enable A dff reset                        (a_pr)
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00000000001100";
    begin
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00000000001100";
    begin
        return result;
    end function;

    signal Z2 : std_logic_vector(55 downto 0);
    signal Z3 : std_logic_vector(55 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);
    signal C1 : std_logic_vector(35 downto 0);
    signal D1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);
    signal C2 : std_logic_vector(35 downto 0);

    signal cascade : std_logic_vector(55 downto 0);
    signal cascade2 : std_logic_vector(55 downto 0);

    begin

        A1 <= A;
        B1 <= B(31)&B(31)&B(31 downto 16);
        C1 <= "00"&Z2(49 downto 16);
        D1 <= Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55 downto 50);

        A2 <= A;
        B2 <= "00"&B(15 downto 0);
        C2 <= "00000000000000000000"&Z2(15 downto 0);

        dsp_mult_1 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_0,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_0,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_0,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => we,
            WEZ  => we,

            CI   => '0',
            A    => A1,
            B    => B1,
            C    => C1,
            D    => D1,
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => open,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade,
            CCO  => open
        );

        dsp_mult_2 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_1,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_1,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_1,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => we,
            WEZ  => we,

            CI   => '0',
            A    => A2,
            B    => B2,
            C    => C2,
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade,
            CCI  => '0',

            Z    => Z2,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade2,
            CCO  => open
        );

        NX_STAGE_4: if (STAGE_4 = true) generate
            dsp_mult_3 : NX_DSP_U_WRAP
            generic map(
                raw_config0 => "000000000000001000001100001",
                raw_config1 => "000000010000000000000000",
                raw_config2 => (others => '0'),
                raw_config3 => (others => '0')
            )
            port map(
                CK   => clk,
                R    => rst,
                RZ   => rst,
                WE   => we,
                WEZ  => we,

                CI   => '0',
                A    => (others => '0'),
                B    => (others => '0'),
                C    => (others => '0'),
                D    => (others => '0'),
                CAI  => (others => '0'),
                CBI  => (others => '0'),
                CZI  => cascade2,
                CCI  => '0',

                Z    => Z3,
                CO43 => open,
                CO57 => open,
                OVF  => open,
                CAO  => open,
                CBO  => open,
                CZO  => open,
                CCO  => open
            );
        end generate NX_STAGE_4;


        Z <= Z2 when STAGE_4 = false else Z3;
end architecture;library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity SMUL24x32_2DSP is
    generic (
        g_pipe : integer := 1 -- range [1 - 5]
        --config_pipe_dsp_0 : bit_vector(23 downto 0) := "000000000100100000010001";
        --config_pipe_dsp_1 : bit_vector(23 downto 0) := "000000010100100000010001";
        --config_reset_dsp_0 : bit_vector(13 downto 0) := "00000100000011";
        --config_reset_dsp_1 : bit_vector(13 downto 0) := "00010100000011"
    );
    port (
        -- Global
        clk : in std_logic := '0';
        rst : in std_logic := '0';
        -- 
        A   : in std_logic_vector(23 downto 0);
        B   : in std_logic_vector(31 downto 0);
        Z   : out std_logic_vector(54 downto 0)
    );
end SMUL24x32_2DSP;

architecture rtl of SMUL24x32_2DSP is

        -- Component NX_DSP_U_WRAP#{{{#
        component NX_DSP_U_WRAP is
            generic (
                std_mode    : string                  := "";
                raw_config0 : bit_vector(26 downto 0) := B"000000000000000000000000000"; -- Mux
                raw_config1 : bit_vector(23 downto 0) := B"000000000000000000000000";    -- Pipe Mux
                raw_config2 : bit_vector(13 downto 0) := B"00000000000000";              -- Pipe Reset
                raw_config3 : bit_vector(2 downto 0)  := B"000"                          -- ALU operation
            );
            port (
                A    : in std_logic_vector(23 downto 0);
                B    : in std_logic_vector(17 downto 0);
                C    : in std_logic_vector(35 downto 0);
        
                CAI  : in std_logic_vector(23 downto 0);
                CAO  : out std_logic_vector(23 downto 0);
                CBI  : in std_logic_vector(17 downto 0);
                CBO  : out std_logic_vector(17 downto 0);
        
                CCI  : in std_logic;
                CCO  : out std_logic;
                CI   : in std_logic;
                CK   : in std_logic;
                CO43 : out std_logic;
                CO57 : out std_logic;
        
                CZI  : in std_logic_vector(55 downto 0);
                CZO  : out std_logic_vector(55 downto 0);
        
                D    : in std_logic_vector(17 downto 0);
        
                OVF  : out std_logic;
                R    : in std_logic;
                RZ   : in std_logic;
                WE   : in std_logic;
                WEZ  : in std_logic;
        
                Z    : out std_logic_vector(55 downto 0)
            );
        end component NX_DSP_U_WRAP;
        --#}}}#

    -- constant raw_config0 : bit_vector(26 downto 0) := "000000000000000000000000000";
    --                                                   "000000000000001000011100000";
    --                                                 33 1                111       invert we
    --                                                 34  1               111       invert wez
    --                                                 35   1              111       invert rst
    --                                                 36    1             111       invert rstz
    --                                                 45     0            111       select bit42 pour cascade carry out (ccy_o)
    --                                                 41      1           111       port C for dynamic operation
    --                                                 42       1          111       port D for dynamic operation
    --                                                 43        xxxxxx    111       saturation rank
    --                                                 44              0   111       saturation {0->bypass ; 1->enable}
    --                                                 46               1  111       ALU {0->bypass ; 1->enable}
    --                                              50&51                00111       cascade carry in {X0->input carry ; 01->cascade carry input ; 11->loopback carry}
    --                                                 48                  111       Y selector : {0->multiplier ; 1->A&B}
    --                                                 47                  111       Z input = {0->cascade ; 1->loopback}
    --                                                 49                  111       big mux selector
    --                                                 52                       0      0->bypass pre-adder ; 1->pre-adder
    --                                                 53                        0     0->B from core logic ; 1->B from cascade
    --                                                 54                         0    0->A from core logic ; 1->A from cascade
    --                                                 55                          0   pre-adder operation : {0->addition ; 1->substraction}
    --                                                 59                           1  signed mode
    function raw_config0_0 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000000000000000001";
    begin
        --return "000000000000000000000000000";
        return result;
    end function;
    --
    function raw_config0_1 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001000001000001";
    begin
        --return "000000000000001000001000000";
        return result;
    end function;
    --
    -- constant raw_config1 : bit_vector(23 downto 0) := "000000000000100000010001";
    --                                                   "000000010000100000010001";
    --                                                  1 0                         bypass we dff                     (we_pr)
    --                                                  2  0                        bypass wez dff                   (wez_pr)
    --                                                  3   0                       bypass rst dff                   (rst_pr)
    --                                                  4    0                      bypass rstz dff                 (rstz_pr)
    --                                                  5     0                     bypass ovf dff                   (ovf_pr)
    --                                                  6      0                    bypass carry output dff          (cyo_pr)
    --                                                  7       0                   bypass cascade carry output dff (ccyo_pr)
    --                                                  8        0                  bypass Z output dff                (z_pr)
    --                                                  9         0                 bypass cascade Z output dff       (cz_pr)
    --                                                 10          0                bypass Y dff                       (y_pr)
    --                                                 11           0               bypass X dff                       (x_pr)
    --                                                 12            0              bypass carry input dff           (cyi_pr)
    --                                                 13             0             bypass multiplier dff              (m_pr)
    --                                                 14              0            bypass pre-adder dff               (p_pr)
    --                                                 15               0           bypass input D dff                 (d_pr)
    --                                                 16                0          bypass input C dff                 (c_pr)
    --                                                 17                 00        X0->bypass ; 01->1dff ; 11->2dff cascade output B
    --                                                 18                   00      X0->bypass ; 01->1dff ; 11->2dff B
    --                                                 19                     00    X0->bypass ; 01->1dff ; 11->2dff cascade output A
    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        constant pipe0 : bit_vector(23 downto 0) := "000000000000000000000000";
        constant pipe1 : bit_vector(23 downto 0) := "000000000000000000010001";
        constant pipe2 : bit_vector(23 downto 0) := "000000000000100000010001";
        constant pipe3 : bit_vector(23 downto 0) := "000000000000100000010001";
        constant pipe4 : bit_vector(23 downto 0) := "000000000100100000010001";
        constant pipe5 : bit_vector(23 downto 0) := "000000000100100000110011";
    begin
        if g_pipe = 1 then
            return pipe0;
        elsif g_pipe = 2 then
            return pipe1;
        elsif g_pipe = 3 then
            return pipe2;
        elsif g_pipe = 4 then
            return pipe3;
        elsif g_pipe = 5 then
            return pipe4;
        else
            return pipe5;
        end if;
    end function;
    function raw_config1_1 return bit_vector is
        constant pipe0 : bit_vector(23 downto 0) := "000000000000000000000000";
        constant pipe1 : bit_vector(23 downto 0) := "000000000000000000010001";
        constant pipe2 : bit_vector(23 downto 0) := "000000000000100000010001";
        constant pipe3 : bit_vector(23 downto 0) := "000000010000100000010001";
        constant pipe4 : bit_vector(23 downto 0) := "000000010100100000010001";
        constant pipe5 : bit_vector(23 downto 0) := "000000010100100000110011";
    begin
        if g_pipe = 1 then
            return pipe0;
        elsif g_pipe = 2 then
            return pipe1;
        elsif g_pipe = 3 then
            return pipe2;
        elsif g_pipe = 4 then
            return pipe3;
        elsif g_pipe = 5 then
            return pipe4;
        else
            return pipe5;
        end if;
    end function;
    --
    -- constant raw_config2 : bit_vector(13 downto 0) := "00000100000011";
    --                                                   "00010100000011";
    --                                                 19 1               enable ovf reset                        (ovf_pr)
    --                                                 20  1              enable carry out reset                  (cyo_pr)
    --                                                 21   1             enable cascade carry out reset         (ccyo_pr)
    --                                                 22    1            enable Z out reset                        (z_pr)
    --                                                 23     1           enable cascade Z output/loopback reset   (cz_pr)
    --                                                 27      1          enable multiplier output reset            (m_pr)
    --                                                 24       1         enable Y reset                            (y_pr)
    --                                                 25        1        enable X reset                            (x_pr)
    --                                                 28         1       enable pre-adder output reset             (p_pr)
    --                                                 26          1      enable carry input reset                (cyi_pr)
    --                                                 29           1     enable D dff reset                        (d_pr)
    --                                                 30            1    enable C dff reset                        (c_pr)
    --                                                 31             1   enable B dff reset                        (b_pr)
    --                                                 32              1  enable A dff reset                        (a_pr)
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00000110000011";
    begin
        --return "00000100000011";
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010110000011";
    begin
        --return "00010100000011";
        return result;
    end function;

    --signal C0 : std_logic;
    --signal Z0 : std_logic_vector(55 downto 0);
    --signal Z0_r : std_logic_vector(41 downto 0);
    signal Z1 : std_logic_vector(55 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);

    signal cascade : std_logic_vector(55 downto 0);

    begin

        A1 <= A;
        B1 <= B(31)&B(31)&B(31 downto 16);

        A2 <= A;
        --B2 <= '0'&B(15)&B(15 downto 0);
        B2 <= "00"&B(15 downto 0);

        dsp_mult_0 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_0,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_0,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_0,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A1,
            B    => B1,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => open,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade,
            CCO  => open
        );

        dsp_mult_1 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_1,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_1,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_1,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A2,
            B    => B2,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade,
            CCI  => '0',

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );


        Z <= Z1(54 downto 0);
end architecture;
