    fabric_spw1_clk_i                                       	    : in  std_logic;  	                                        		 --SERVICE_SPW(1)		  Clock
    fabric_spw1_clk_tx_i                                    	    : in  std_logic;  	                                        		 --SERVICE_SPW(1)		  Clock TX
    fabric_spw1_rst_n_i                                     	    : in  std_logic;  	                                        		 --SERVICE_SPW(1)		  Reset_n
    fabric_spw1_user_shared_o                               	    : out std_logic;  	                                        		 --SERVICE_SPW(1)		  Spacewire controller is in shared between BSM and Fabric
    fabric_spw1_tx_fifo_write_i                             	    : in  std_logic;  	                                        		 --SERVICE_SPW(1)		  write fifo
