      AO2    => AO(1),
      AO3    => AO(2),
      AO4    => AO(3),
      AO5    => AO(4),
      AO6    => AO(5),
      --BSRSTI => BSRSTI,
      --BDRSTI => BDRSTI,
      BI1    => BI(0),
      BI2    => BI(1),
      BI3    => BI(2),
      BI4    => BI(3),
      BI5    => BI(4),
      BI6    => BI(5),
      BO1    => BO(0),
      BO2    => BO(1),
      BO3    => BO(2),
      BO4    => BO(3),
      BO5    => BO(4),
      BO6    => BO(5),
      --CSRSTI => '0',
      --CDRSTI => '0',
