entity NX_DAC_U is
  generic (
    location                : string := "";
    cfg_dac_sync_i          : std_logic;
    cfg_dac_res_i           : std_logic_vector(1 downto 0); -- unused in simulation
    cfg_dac_vref_select_i   : std_logic;                    -- unused in simulation
    cfg_dac_cm_select_i     : std_logic                     -- unused in simulation
  );
  port ( 
    dac_clk_i               : in  std_logic;    -- Fmax = 10MHz
    dac_rst_n_i             : in  std_logic;
    usr_dac_i1               : in  std_logic;    -- DAC input word
    usr_dac_i2               : in  std_logic;    -- DAC input word
    usr_dac_i3               : in  std_logic;    -- DAC input word
    usr_dac_i4               : in  std_logic;    -- DAC input word
    usr_dac_i5               : in  std_logic;    -- DAC input word
    usr_dac_i6               : in  std_logic;    -- DAC input word
    usr_dac_i7               : in  std_logic;    -- DAC input word
    usr_dac_i8               : in  std_logic;    -- DAC input word
    usr_dac_i9               : in  std_logic;    -- DAC input word
    usr_dac_i10              : in  std_logic;    -- DAC input word
    usr_dac_i11              : in  std_logic;    -- DAC input word
    usr_dac_i12              : in  std_logic;    -- DAC input word
    usr_dac_i13              : in  std_logic;    -- DAC input word
    usr_dac_comp_sel_i1      : in  std_logic; -- Comparator input selection
    usr_dac_comp_sel_i2      : in  std_logic; -- Comparator input selection
    usr_dac_comp_sel_i3      : in  std_logic; -- Comparator input selection
    usr_dac_comp_sel_i4      : in  std_logic; -- Comparator input selection
    dac_comp_ref_sel_i        : in  std_logic;    -- select btween comp_in or ref_in(0.9)
    usr_dac_filter_en_i       : in  std_logic;    -- unused in simulation
    usr_dac_comp_hyst_en_i    : in  std_logic;
    dac_comp_en_i             : in  std_logic;    -- enable comp calculation
    dac_op_en_i               : in  std_logic;    -- enable comp output
    usr_dac_pwr_dn_i          : in  std_logic;    -- Power down mode (unused in simulation)
    usr_dac_clk_en_i          : in  std_logic;    -- Clock gating command (unused in simulation)
    usr_dac_comp_o            : out std_logic     -- Comparator output
  );
end NX_DAC_U;
