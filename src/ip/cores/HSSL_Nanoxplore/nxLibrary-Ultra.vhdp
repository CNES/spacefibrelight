    mem_ctxt  : string := "" -- memory initial context
);
port (
    WCK : in  std_logic;
    I   : in  std_logic_vector(17 downto 0);
    AO  : out std_logic_vector(17 downto 0);
    BO  : out std_logic_vector(17 downto 0);
