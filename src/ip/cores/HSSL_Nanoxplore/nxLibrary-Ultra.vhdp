);
end NX_SERVICE_IF_U_WRAP;

architecture NX_ARCH of NX_SERVICE_IF_U_WRAP is
begin

    inst_NX_SERVICE_IF : NX_SERVICE_IF_U
    generic map (
         bsm_config                                                => bsm_config
    )
    port map (
    arst_tmr_n_i1                                                   => arst_tmr_n_i(0)       
    ,arst_tmr_n_i2                                                  => arst_tmr_n_i(1)       
    ,arst_tmr_n_i3                                                  => arst_tmr_n_i(2)       
    ,clk_i                                                          => clk_i                                                     
    ,spi_clk_i                                                      => spi_clk_i   

    ,pad_spi_rst_n_o1                                               => pad_spi_rst_n_o(0)                  
    ,pad_spi_rst_n_o2                                               => pad_spi_rst_n_o(1)                  
    ,pad_spi_rst_n_o3                                               => pad_spi_rst_n_o(2)                  
    ,pad_spi_rst_n_oe_o1                                            => pad_spi_rst_n_oe_o(0)            
    ,pad_spi_rst_n_oe_o2                                            => pad_spi_rst_n_oe_o(1)            
    ,pad_spi_rst_n_oe_o3                                            => pad_spi_rst_n_oe_o(2)            
    ,pad_spi_vcc_o1                                                 => pad_spi_vcc_o(0)                      
    ,pad_spi_vcc_o2                                                 => pad_spi_vcc_o(1)                      
    ,pad_spi_vcc_o3                                                 => pad_spi_vcc_o(2)                      
    ,pad_spi_vcc_o4                                                 => pad_spi_vcc_o(3)                      
    ,pad_spi_vcc_o5                                                 => pad_spi_vcc_o(4)                      
    ,pad_spi_vcc_o6                                                 => pad_spi_vcc_o(5)                      
    ,pad_spi_vcc_o7                                                 => pad_spi_vcc_o(6)                      
    ,pad_spi_vcc_o8                                                 => pad_spi_vcc_o(7)                      
    ,pad_spi_vcc_o9                                                 => pad_spi_vcc_o(8)                      
    ,pad_spi_vcc_oe_o1                                              => pad_spi_vcc_oe_o(0)                
    ,pad_spi_vcc_oe_o2                                              => pad_spi_vcc_oe_o(1)                
    ,pad_spi_vcc_oe_o3                                              => pad_spi_vcc_oe_o(2)                
    ,pad_spi_vcc_oe_o4                                              => pad_spi_vcc_oe_o(3)                
