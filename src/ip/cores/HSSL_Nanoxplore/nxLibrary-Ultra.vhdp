    adc_cal_updt_val_i2       => adc_cal_updt_val_i(1),
    adc_cal_updt_val_i3       => adc_cal_updt_val_i(2),
    adc_cal_updt_val_i4       => adc_cal_updt_val_i(3),
    adc_cal_updt_val_i5       => adc_cal_updt_val_i(4),
    adc_cal_updt_val_i6       => adc_cal_updt_val_i(5),
  
    -- CONVERSION
    adc_cfg_usr_channel_i1    => adc_cfg_usr_channel_i(0),
    adc_cfg_usr_channel_i2    => adc_cfg_usr_channel_i(1),
    adc_cfg_usr_channel_i3    => adc_cfg_usr_channel_i(2),
  
    adc_conv_start_i              => adc_conv_start_i,          
    adc_cfg_free_running_i        => adc_cfg_free_running_i,    
    adc_free_nb_sample_cycles1    => adc_free_nb_sample_cycles(0),
    adc_free_nb_sample_cycles2    => adc_free_nb_sample_cycles(1),
    adc_free_nb_sample_cycles3    => adc_free_nb_sample_cycles(2),
    adc_free_nb_sample_cycles4    => adc_free_nb_sample_cycles(3),
    adc_usr_sample_i1             => adc_usr_sample_i(0),         
    adc_usr_sample_i2             => adc_usr_sample_i(1),         
    adc_usr_sample_i3             => adc_usr_sample_i(2),         
    adc_usr_sample_i4             => adc_usr_sample_i(3),         
    
    adc_conv_done_o               => adc_conv_done_o,
    adc_sample_data_o1            => adc_sample_data_o(0),
    adc_sample_data_o2            => adc_sample_data_o(1),
    adc_sample_data_o3            => adc_sample_data_o(2),
    adc_sample_data_o4            => adc_sample_data_o(3),
    adc_sample_data_o5            => adc_sample_data_o(4),
    adc_sample_data_o6            => adc_sample_data_o(5),
    adc_sample_data_o7            => adc_sample_data_o(6),
    adc_sample_data_o8            => adc_sample_data_o(7),
    adc_sample_data_o9            => adc_sample_data_o(8),
    adc_sample_data_o10           => adc_sample_data_o(9),
    adc_sample_data_o11           => adc_sample_data_o(10),
    adc_sample_data_o12           => adc_sample_data_o(11)
    );
  
  end NX_RTL;
