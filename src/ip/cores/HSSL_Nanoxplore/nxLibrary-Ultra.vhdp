    dyn_cfg_wdata_sel_i     : in  std_logic;
    dyn_cfg_wdata_i         : in  std_logic_vector(6 downto 0);
    dyn_cfg_rdata_o         : out std_logic_vector(6 downto 0);
    --
    scan_en_i               : in std_logic;
    scan_in_i               : in std_logic_vector(36 downto 0);
    scan_out_o              : out std_logic_vector(36 downto 0)
  );
end NX_PLL_U_FULL;

architecture NX_PROD of NX_PLL_U_FULL is

component NX_PLL_U_BOX is 
  generic (
    location                        : string  := "CKG1";

    cfg_use_pll                     : std_logic;
