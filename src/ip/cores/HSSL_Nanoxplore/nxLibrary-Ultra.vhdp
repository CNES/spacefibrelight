        variable cfg_reg0_cdc_w2r_arst_src_sel_i    : std_logic;
        variable cfg_reg0_cdc_w2r_gray_linked_i     : std_logic;
        variable cfg_reg0_cdc_w2r_use_g2b_i         : std_logic;
        variable cfg_reg0_cdc_w2r_use_b2g_i         : std_logic;
