    DRIN   : in std_logic_vector(2 downto 0);
    DRDN   : in std_logic_vector(2 downto 0);
    DRA    : in std_logic_vector(3 downto 0);
    DRI   : in std_logic_vector(5 downto 0);

    FA     : in std_logic_vector(5 downto 0);
