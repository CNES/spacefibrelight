    fabric_spi_clk_i                                                : in  std_logic_vector((3)-1 downto 0);
    fabric_spi_sck_i                                                : in  std_logic_vector((3)-1 downto 0);
    fabric_spi_needed_i                                     	    : in  std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		  Fabric SPI needed, active high
    fabric_spi_bsm_release_o                                	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		  Fabric SPI BSM release flag, active high
    fabric_spi_arst_tmr_n_i                                 	    : in  std_logic_vector((3*3)-1 downto 0);                     		 --SERVICE_SPI		  Fabric SPI host clock domain reset
