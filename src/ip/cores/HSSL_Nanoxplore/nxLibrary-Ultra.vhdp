    fabric_thsens_fm_config_wen_i                           	    : in  std_logic;                                               		 --SERVICE_VTSENS		  Config Reg write enable
    fabric_thsens_fm_data_o                                 	    : out std_logic_vector((14)-1 downto 0);                             --SERVICE_VTSENS		  Data out all bits in measurements modes and only 9 LSBs in calibration mode
    fabric_thsens_fm_valid_o                                	    : out std_logic;                                            		 --SERVICE_VTSENS		  Data valid
    fabric_thsens_fm_overflow_o                             	    : out std_logic;                                            		 --SERVICE_VTSENS		  Overflow flag
