    arst_pll_i	: in std_logic := '0';
    clk_cal	: in std_logic := '0';
    clk_pll	: out std_logic;
    clk_pll_ldf_div	: out std_logic;
    clk_pll_ref_div	: out std_logic;
    clk_pll_div	: out std_logic_vector(3 downto 0);
