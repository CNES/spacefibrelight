        -- 
    A	: in std_logic_vector(23 downto 0) := (others => '0');
    B	: in std_logic_vector(31 downto 0) := (others => '0');
    Z	: out std_logic_vector(91 downto 0)
    );
end component SMUL24x32_2DSP_ACC_2DSP_L;

