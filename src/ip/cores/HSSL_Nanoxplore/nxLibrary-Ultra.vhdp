    CI2    : in  std_logic;
    CI3    : in  std_logic;
    CI4    : in  std_logic;
    CI5    : in  std_logic;
    CI6    : in  std_logic;
    CO1    : out std_logic;
    CO2    : out std_logic;
    CO3    : out std_logic;
    CO4    : out std_logic;
    CO5    : out std_logic;
    CO6    : out std_logic;
    --DSRSTI : in  std_logic;
    --DDRSTI : in  std_logic;
