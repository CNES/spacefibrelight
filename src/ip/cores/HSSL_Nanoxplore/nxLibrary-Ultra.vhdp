entity VERIFIC_DLATCH is
port (
  d            : in    std_logic;
  gate         : in    std_logic;
  async_cond   : in    std_logic;
  async_val    : in    std_logic;
  q            : out   std_logic
);
end VERIFIC_DLATCH;

architecture Synthesized of VERIFIC_DLATCH is
   signal s    : std_logic;
   signal r    : std_logic;

begin
   s     <= async_cond and async_val;
   r     <= async_cond and not(async_val);

   process (gate, r, s, d)
   begin
     if (r = '1') then
       q <= '0';
     else
         if (s = '1') then
            q <= '1';
         else
            if (gate = '1') then
               q <= d;
            end if;
         end if;
      end if;
   end process;
end;

