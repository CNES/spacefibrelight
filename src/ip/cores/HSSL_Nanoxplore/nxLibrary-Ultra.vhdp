    fabric_spw1_tick_ctm_o                                  	    : out std_logic;                                            		 --SERVICE_SPW(1)		  good time code received
    fabric_spw1_apb_slv_psel_i                              	    : in  std_logic;                                            		 --SERVICE_SPW(1)		  APB Slave - Slave select
    fabric_spw1_apb_slv_penable_i                           	    : in  std_logic;                                            		 --SERVICE_SPW(1)		  APB Slave - Strobe
