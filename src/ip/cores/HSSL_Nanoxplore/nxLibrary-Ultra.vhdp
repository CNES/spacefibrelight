  path                : integer := 0;
  --
  dff_type            : std_logic := '0';   -- cfg_rs_i_0
  dff_sync            : std_logic := '0';   -- cfg_rs_i_1
  dff_load            : std_logic := '0'    -- cfg_ld_force_i
);
port (
    CK	: in std_logic := '0';
    R	: in std_logic := '0';
    I1	: in std_logic := '0';
    I2	: in std_logic := '0';
    L	: in std_logic := '0';
    O	: out std_logic
);
end component NX_ODDFR_U;

component ACC92_2DSP is
generic (
        g_pipe : integer := 2 -- range between [1 - 3]
    );
port (
        -- Global
    clk	: in std_logic := '0';
    rst	: in std_logic := '0';
        -- 
    X	: in std_logic_vector(55 downto 0) := (others => '0');
    Z	: out std_logic_vector(91 downto 0)
    );
end component ACC92_2DSP;

