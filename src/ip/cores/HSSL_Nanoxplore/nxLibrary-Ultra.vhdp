    inputDelayLine       : string  := "";
    outputDelayOn        : string  := "";
    outputDelayLine      : string  := "";
    inputSignalSlope     : string  := "";
    outputCapacity       : string  := "";
    dynDrive             : string  := "";
    dynInput             : string  := "";
    dynTerm              : string  := "";
    extra                : integer :=  1;
    locked               : bit     := '0'
);
port (
--  I  : in  std_logic;			// To prevent error in instanciation
    C  : in  std_logic;
    T  : in  std_logic;
    IO : in  std_logic;
    O  : out std_logic
);
