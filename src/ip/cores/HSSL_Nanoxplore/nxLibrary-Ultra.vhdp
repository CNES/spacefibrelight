      CI2    => '0',
      CI3    => '0',
      CI4    => '0',
      CI5    => '0',
      CI6    => '0',
      CO1    => OPEN,
      CO2    => OPEN,
      CO3    => OPEN,
      CO4    => OPEN,
      CO5    => OPEN,
