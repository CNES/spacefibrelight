    pll_lock_o	: out std_logic;
    pll_locka_o	: out std_logic;
    arst_cal_i	: in std_logic := '0';
    clk_cal_div	: out std_logic;
    cal_lock_o	: out std_logic;
    ext_cal_lock_i	: in std_logic := '0';
    ext_calibration_o	: out std_logic_vector(4 downto 0);
    ext_calibration_i	: in std_logic_vector(4 downto 0) := (others => '0');
    dyn_cfg_en_i	: in std_logic := '0';
    dyn_cfg_cs_n_i	: in std_logic_vector(2 downto 0) := (others => '0');
    dyn_cfg_we_n_i	: in std_logic := '0';
    dyn_cfg_addr_i	: in std_logic_vector(3 downto 0) := (others => '0');
    dyn_cfg_wdata_sel_i	: in std_logic := '0';
    dyn_cfg_wdata_i	: in std_logic_vector(6 downto 0) := (others => '0');
    dyn_cfg_rdata_o	: out std_logic_vector(6 downto 0);
    --
    scan_en_i	: in std_logic := '0';
    scan_in_i	: in std_logic_vector(36 downto 0) := (others => '0');
    scan_out_o	: out std_logic_vector(36 downto 0)
  );
end component NX_PLL_U_FULL;

