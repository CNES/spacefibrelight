                C    : in std_logic_vector(35 downto 0);
        
                CAI  : in std_logic_vector(23 downto 0);
                CAO  : out std_logic_vector(23 downto 0);
                CBI  : in std_logic_vector(17 downto 0);
                CBO  : out std_logic_vector(17 downto 0);
        
                CCI  : in std_logic;
                CCO  : out std_logic;
                CI   : in std_logic;
                CK   : in std_logic;
                CO43 : out std_logic;
                CO57 : out std_logic;
        
                CZI  : in std_logic_vector(55 downto 0);
                CZO  : out std_logic_vector(55 downto 0);
        
                D    : in std_logic_vector(17 downto 0);
        
                OVF  : out std_logic;
                R    : in std_logic;
                RZ   : in std_logic;
                WE   : in std_logic;
                WEZ  : in std_logic;
        
                Z    : out std_logic_vector(55 downto 0)
            );
        end component NX_DSP_U_WRAP;
        --#}}}#

    -- constant raw_config0 : bit_vector(26 downto 0) := "000000000000001000000100000";
    --                                                   "000000000000001000001000000";
    --                                                 33 1                            invert we
    --                                                 34  1                           invert wez
    --                                                 35   1                          invert rst
    --                                                 36    1                         invert rstz
    --                                                 45     0                        select bit42 pour cascade carry out (ccy_o)
    --                                                 41      1                       port C for dynamic operation
    --                                                 42       1                      port D for dynamic operation
    --                                                 43        xxxxxx                saturation rank
    --                                                 44              0               saturation {0->bypass ; 1->enable}
    --                                                 46               1              ALU {0->bypass ; 1->enable}
    --                                              50&51                00            cascade carry in {X0->input carry ; 01->cascade carry input ; 11->loopback carry}
    --                                                 48                              Y selector : {0->multiplier ; 1->A&B}
    --                                                 47                              Z input = {0->cascade ; 1->loopback}
    --                                                 49                              big mux selector
    --                                                 52                       0      0->bypass pre-adder ; 1->pre-adder
    --                                                 53                        0     0->B from core logic ; 1->B from cascade
    --                                                 54                         0    0->A from core logic ; 1->A from cascade
    --                                                 55                          0   pre-adder operation : {0->addition ; 1->substraction}
    --                                                 59                           1  signed mode
    function raw_config0_0 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001000000100000";
    begin
        --return "000000000000001000000100000";
        return result;
    end function;
    --
    function raw_config0_1 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001000001000000";
    begin
        --return "000000000000001000001000000";
        return result;
    end function;
    --
    -- constant raw_config1 : bit_vector(23 downto 0) := "000000011010101100010001";
    --                                                   "000000011100100100010001";
    --                                                  1 0                         bypass we dff                     (we_pr)
    --                                                  2  0                        bypass wez dff                   (wez_pr)
    --                                                  3   0                       bypass rst dff                   (rst_pr)
    --                                                  4    0                      bypass rstz dff                 (rstz_pr)
    --                                                  5     0                     bypass ovf dff                   (ovf_pr)
    --                                                  6      0                    bypass carry output dff          (cyo_pr)
    --                                                  7       0                   bypass cascade carry output dff (ccyo_pr)
    --                                                  8        0                  bypass Z output dff                (z_pr)
    --                                                  9         0                 bypass cascade Z output dff       (cz_pr)
    --                                                 10          0                bypass Y dff                       (y_pr)
    --                                                 11           0               bypass X dff                       (x_pr)
    --                                                 12            0              bypass carry input dff           (cyi_pr)
    --                                                 13             0             bypass multiplier dff              (m_pr)
    --                                                 14              0            bypass pre-adder dff               (p_pr)
    --                                                 15               0           bypass input D dff                 (d_pr)
    --                                                 16                0          bypass input C dff                 (c_pr)
    --                                                 17                 00        X0->bypass ; 01->1dff ; 11->2dff cascade output B
    --                                                 18                   00      X0->bypass ; 01->1dff ; 11->2dff B
    --                                                 19                     00    X0->bypass ; 01->1dff ; 11->2dff cascade output A
    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000011010101100010001";
    begin
        --return "000000011010101100010001";
        return result;
    end function;
    function raw_config1_1 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000011100100100010001";
    begin
        --return "000000011100100100010001";
        return result;
    end function;
    --
    -- constant raw_config2 : bit_vector(13 downto 0) := "00011101001111";
    --                                                   "00010110000111";
    --                                                 19 1              enable ovf reset                        (ovf_pr)
    --                                                 20  1             enable carry out reset                  (cyo_pr)
    --                                                 21   1            enable cascade carry out reset         (ccyo_pr)
    --                                                 22                enable Z out reset                        (z_pr)
    --                                                 23     1           enable cascade Z output/loopback reset   (cz_pr)
    --                                                 27      1          enable multiplier output reset            (m_pr)
    --                                                 24       1         enable Y reset                            (y_pr)
    --                                                 25        1        enable X reset                            (x_pr)
    --                                                 28         1       enable pre-adder output reset             (p_pr)
    --                                                 26          1      enable carry input reset                (cyi_pr)
    --                                                 29           1     enable D dff reset                        (d_pr)
    --                                                 30            1    enable C dff reset                        (c_pr)
    --                                                 31             1   enable B dff reset                        (b_pr)
    --                                                 32              1  enable A dff reset                        (a_pr)
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00011101001111";
    begin
        --return "00011101001111";
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010110000111";
    begin
        --return "00010110000111";
        return result;
    end function;

    --signal C0 : std_logic;
    signal Z0 : std_logic_vector(55 downto 0);
    signal Z0_r : std_logic_vector(17 downto 0);
    signal Z1 : std_logic_vector(55 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);
    signal C1 : std_logic_vector(35 downto 0);
    signal D1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);
    signal C2 : std_logic_vector(35 downto 0);

    signal C2_r     : std_logic_vector(35 downto 0);
    signal C2_r1    : std_logic_vector(35 downto 0);
    signal C2_r2    : std_logic_vector(35 downto 0);
    signal C2_r1p    : std_logic_vector(35 downto 0); -- use for delta

    signal cascade : std_logic_vector(55 downto 0);

    begin

        A1 <= A;
        B1 <= "00"&B(31 downto 16);
        C1 <= "00"&C(49 downto 16);
        D1 <= "000000000000"&C(55 downto 50);

        A2 <= A;
        B2 <= "00"&B(15 downto 0);
        C2 <= "00000000000000000000"&C(15 downto 0);

        dsp_mult_0 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_0,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_0,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_0,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A1,
            B    => B1,
            C    => C1,
            D    => D1,
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => Z0,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade,
            CCO  => open
        );

        dsp_mult_1 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_1,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_1,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_1,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A2,
            B    => B2,
            C    => C2_r1,
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade,
            CCI  => '0',

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        input_pipe : process (clk)
        begin
            if rising_edge(clk) then
                C2_r <= C2;
                C2_r1 <= C2_r;
                --C2_r2 <= C2_r1;
            end if;
        end process input_pipe;
    
    --C2_r1p <= C2_r1 after 0ns;
    Z  <= Z1;

end architecture;library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

