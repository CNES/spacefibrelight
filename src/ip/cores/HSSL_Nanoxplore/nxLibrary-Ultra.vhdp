library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity SMUL24x32_2DSP_ACC_2DSP_L is
    port (
        -- Global
        clk : in std_logic := '0';
        rst : in std_logic := '0';
        we  : in std_logic := '1';
        -- 
        A   : in std_logic_vector(23 downto 0);
        B   : in std_logic_vector(31 downto 0);
        Z   : out std_logic_vector(91 downto 0)
    );
end SMUL24x32_2DSP_ACC_2DSP_L;

architecture rtl of SMUL24x32_2DSP_ACC_2DSP_L is

    constant MASK_DSP_STAGE_1_TRUE : bit_vector(23 downto 0) := "000000000000000000010001";
    constant MASK_DSP_STAGE_2_TRUE : bit_vector(23 downto 0) := "000000000000100000000000";
    constant MASK_DSP_STAGE_3_TRUE : bit_vector(23 downto 0) := "000000000100000000000000";

    component nx_dsp_l_wrap is
        generic (
            std_mode    : string                  := "";
            raw_config0 : bit_vector(19 downto 0) := B"00000000000000000000"; -- Mux
            raw_config1 : bit_vector(18 downto 0) := B"0000000000000000000";    -- Pipe Mux
            raw_config2 : bit_vector(12 downto 0) := B"0000000000000";              -- Pipe Reset
            raw_config3 : bit_vector(6 downto 0)  := B"0000000"                          -- ALU operation
        );
        port (
            A    : in std_logic_vector(23 downto 0);
            B    : in std_logic_vector(17 downto 0);
            C    : in std_logic_vector(35 downto 0);
    
            CAI  : in std_logic_vector(23 downto 0);
            CAO  : out std_logic_vector(23 downto 0);
            CBI  : in std_logic_vector(17 downto 0);
            CBO  : out std_logic_vector(17 downto 0);
    
            CCI  : in std_logic;
            CCO  : out std_logic;
            CI   : in std_logic;
            CK   : in std_logic;
            CO   : out std_logic;
            CO37 : out std_logic;
            CO57 : out std_logic;
    
            CZI  : in std_logic_vector(55 downto 0);
            CZO  : out std_logic_vector(55 downto 0);
    
            D    : in std_logic_vector(17 downto 0);
    
            OVF  : out std_logic;
            R    : in std_logic;
            RZ   : in std_logic;
            WE   : in std_logic;
    
            Z    : out std_logic_vector(55 downto 0)
        );
    end component;

    component ACC92_2DSP is
        generic (
            g_pipe : integer := 1 -- range between [1 - 3]
        );
        port (
            -- Global
            clk : in std_logic := '0';
            rst : in std_logic := '0';
            -- 
            X   : in std_logic_vector(55 downto 0);
            Z   : out std_logic_vector(91 downto 0)
        );
    end component;

    function raw_config0_0 return bit_vector is
        constant result : bit_vector(19 downto 0) := "00000000010001100001";
    begin
        return result;
    end function;
    --
    function raw_config0_1 return bit_vector is
        constant result : bit_vector(19 downto 0) := "00000000010001100001";
    begin
        return result;
    end function;
    --
    function raw_config1_0 return bit_vector is
        variable config : bit_vector(18 downto 0) := "0000010000000010001";
    begin
        return config;
    end function;

    function raw_config1_1 return bit_vector is
        variable config : bit_vector(18 downto 0) := "0000010000000010001";
    begin
        return config;
    end function;
    --
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(12 downto 0) := "0011011000011";
    begin
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(12 downto 0) := "0011011000011";
    begin
        return result;
    end function;
    --
    function raw_config3_0 return bit_vector is
        constant result : bit_vector(6 downto 0) := "0000000";
    begin
        return result;
    end function;
    function raw_config3_1 return bit_vector is
        constant result : bit_vector(6 downto 0) := "0000000";
    begin
        return result;
    end function;

    signal Z2 : std_logic_vector(55 downto 0);
    signal Z4 : std_logic_vector(91 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);
    signal C1 : std_logic_vector(35 downto 0);
    signal D1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);
    signal C2 : std_logic_vector(35 downto 0);

    signal cascade : std_logic_vector(55 downto 0);
    signal cascade2 : std_logic_vector(55 downto 0);

    begin

        A1 <= A;
        B1 <= B(31)&B(31)&B(31 downto 16);
        C1 <= "00"&Z2(49 downto 16);
        D1 <= Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55)&Z2(55 downto 50);

        A2 <= A;
        B2 <= "00"&B(15 downto 0);
        C2 <= "00000000000000000000"&Z2(15 downto 0);

        dsp_mult_1 : NX_DSP_L_WRAP
        generic map(
            raw_config0 => raw_config0_0,
            raw_config1 => raw_config1_0,
            raw_config2 => raw_config2_0,
            raw_config3 => raw_config3_0
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => we,

            CI   => '0',
            CO   => open,
            A    => A1,
            B    => B1,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => open,
            CO37 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade,
            CCO  => open
        );

        dsp_mult_2 : NX_DSP_L_WRAP
        generic map(
            raw_config0 => raw_config0_1,
            raw_config1 => raw_config1_1,
            raw_config2 => raw_config2_1,
            raw_config3 => raw_config3_1
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => we,

            CI   => '0',
            CO   => open,
            A    => A2,
            B    => B2,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade,
            CCI  => '0',

            Z    => Z2,
            CO37 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade2,
            CCO  => open
        );

        dsp_acc_98 : ACC92_2DSP
        generic map(
            g_pipe => 1
        )
        port map (
            clk => clk,
            rst => rst,
            X   => Z2,
            Z   => Z4
        );

        Z <= Z4;
end architecture;-- =================================================================================================
--   NX_DSP definition                                                                  2018/11/30
