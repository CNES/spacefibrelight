    arst_pll_i              : in  std_logic;
    clk_cal                 : in  std_logic;
    clk_pll                 : out std_logic;
    clk_pll_ldf_div         : out std_logic;
    clk_pll_ref_div         : out std_logic;
    clk_pll_div             : out std_logic_vector(3 downto 0);
    clk_pll_div_dyn         : out std_logic_vector(4 downto 0);
    pll_lock_o              : out std_logic;
    pll_locka_o             : out std_logic;
    arst_cal_i              : in  std_logic;
    clk_cal_div             : out  std_logic;
    cal_lock_o              : out std_logic;
    ext_cal_lock_i          : in  std_logic;
    ext_calibration_o       : out std_logic_vector(4 downto 0);
    ext_calibration_i       : in  std_logic_vector(4 downto 0);
    dyn_cfg_en_i            : in  std_logic;
    dyn_cfg_cs_n_i          : in  std_logic_vector(2 downto 0);
    dyn_cfg_we_n_i          : in  std_logic;
