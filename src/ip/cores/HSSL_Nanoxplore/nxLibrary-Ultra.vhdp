library ieee;
use ieee.std_logic_1164.all;

library NX;
use NX.nxPackage.all;

--use work.nxDesign.all;

entity GENERIC_AND is
port (
  a0                  : in    std_logic;
  a1                  : in    std_logic;
  o                   : out   std_logic
);
end GENERIC_AND;

architecture Synthesized of GENERIC_AND is
begin
    o <= a0 AND a1;
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_OR is
port (
  a0                  : in    std_logic;
  a1                  : in    std_logic;
  o                   : out   std_logic
);
end GENERIC_OR;

architecture Synthesized of GENERIC_OR is
begin
    o <= a0 OR a1;
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_XOR is
port (
  a0                  : in    std_logic;
  a1                  : in    std_logic;
  o                   : out   std_logic
);
end GENERIC_XOR;

architecture Synthesized of GENERIC_XOR is
begin
    o <= a0 XOR a1;
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_MUX is
port (
  a0                  : in    std_logic;
  a1                  : in    std_logic;
  c                   : in    std_logic;
  o                   : out   std_logic
);
end GENERIC_MUX;

architecture Synthesized of GENERIC_MUX is
begin
    o <= a0 when c = '0' else a1 when c = '1' else 'X';
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_INV is
port (
  i                   : in    std_logic;
  o                   : out   std_logic
);
end GENERIC_INV;

architecture Synthesized of GENERIC_INV is
begin
    o <= not i;
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_GND is
port (
  o                   : out   std_logic
);
end GENERIC_GND;

architecture Synthesized of GENERIC_GND is
begin
    o <= '0';
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_PWR is
port (
  o                   : out   std_logic
);
end GENERIC_PWR;

architecture Synthesized of GENERIC_PWR is
begin
    o <= '1';
end;

library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_X is
port (
  o                   : out   std_logic
);
end GENERIC_X;

architecture Synthesized of GENERIC_X is
begin
    o <= 'X';
end;

