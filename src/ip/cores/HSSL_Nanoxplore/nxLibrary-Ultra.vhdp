			 , EI2  => I_int(1)
			 , EI3  => I_int(2)
			 , EI4  => I_int(3)
			 , EI5  => I_int(4)
			 , EI6  => I_int(5)
			 , EI7  => I_int(6)
			 , EI8  => I_int(7)
			 , RI   => OPEN
			 , EO   => I_pad
			 , CO   => C_pad
			 , LINK => LINK
		);
end generate;

large_ser: if (8 < data_size) generate
end generate;

cvt: NX_IOM_BIN2GRP
		   port map (
			      LA   => DRA
			    , GS   => DRL
			    , PA   => GPA
			    , GVON => GVON
			    , GVIN => GVIN
			    , GVDN => GVDN
		   );

iom: NX_IOM_SERDES_U generic map (data_size => data_size, location => location)
