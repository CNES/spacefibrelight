            INITPPX0               : in std_logic;        
            PPXBASE0               : in std_logic_vector(19 downto 0);        
            PPXSIZE0               : in std_logic_vector(4 downto 0);        
            PPVBASE0               : in std_logic_vector(19 downto 0);        
            PPVSIZE0               : in std_logic_vector(4 downto 0);        
