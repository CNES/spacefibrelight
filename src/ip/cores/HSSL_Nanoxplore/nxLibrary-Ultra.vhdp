-- =================================================================================================
--  NX_SERVICE_IF_U_WRAP definition
-- =================================================================================================

library IEEE;
use IEEE.STD_LOGIC_1164.all;

library NX;
use NX.nxPackage.all;
entity NX_SERVICE_IF_U_WRAP is
generic (
    bsm_config : bit_vector(31 downto 0) := (others => '0')
);
port (
    arst_tmr_n_i                                                    : in std_logic_vector(2 downto 0);         
    clk_i                                                           : in std_logic;                                                                   
    spi_clk_i                                                       : in std_logic;  

      -- Pads interface
    pad_spi_rst_n_o                                                 : out std_logic_vector(3-1 downto 0);
    pad_spi_rst_n_oe_o                                              : out std_logic_vector(3-1 downto 0);
    pad_spi_vcc_o                                                   : out std_logic_vector(3*3-1 downto 0);
    pad_spi_vcc_oe_o                                                : out std_logic_vector(3*3-1 downto 0);
    pad_spi_vcc_i                                                   : in  std_logic_vector(3*3-1 downto 0);
    pad_spi_sck_i                                                   : in std_logic_vector(3-1 downto 0);
    pad_spi_sck_o                                                   : out std_logic_vector(3-1 downto 0);
    pad_spi_sck_oe_o                                                : out std_logic_vector(3-1 downto 0);
    pad_spi_cs_n_i                                                  : in std_logic_vector(3-1 downto 0);
    pad_spi_cs_n_o                                                  : out std_logic_vector(3-1 downto 0);
    pad_spi_cs_n_oe_o                                               : out std_logic_vector(3-1 downto 0);
    pad_spi_io_i                                                    : in  std_logic_vector(3*4-1 downto 0);
    pad_spi_io_o                                                    : out std_logic_vector(3*4-1 downto 0);
    pad_spi_io_oe_o                                                 : out std_logic_vector(3*4-1 downto 0);

    fabric_otp_user_clk_i                                   	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABL]->[OTP_USER] Clock
    fabric_otp_user_bistmode_i                              	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Select BIST mode
    fabric_otp_user_disturbcheck_i                          	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Reading with conditions check
    fabric_otp_user_eccbypass_i                             	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Remove ECC coding/decoding
    fabric_otp_user_pdn_i                                   	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Power switch control
    fabric_otp_user_prog_i                                  	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Start programming operation
    fabric_otp_user_rbact1_i                                	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Start BIST1 in BIST mode
    fabric_otp_user_rbact2_i                                	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Start BIST2 in BIST mode
    fabric_otp_user_read_i                                  	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Start reading operation
    fabric_otp_user_redbypass_i                             	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Remove self-redundancy
    fabric_otp_user_suppadd_i                               	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Gives access to supplementary address space
    fabric_otp_user_tm_i                                    	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Scan Test mode selection
    fabric_otp_user_tst_scanenable_i                        	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Scan test enable
    fabric_otp_user_wordlock_i                              	    : in  std_logic;                                                     --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Indicate if word has to be locked  when programming
    fabric_otp_user_add_i                                   	    : in  std_logic_vector((7)-1 downto 0);                        		 --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Address input bus
    fabric_otp_user_clock_frequency_range_i                 	    : in  std_logic;                                             		 --SERVICE_OTP		  **ok [FAB]->[OTP_USER]  // 0=freq 12.5-40 MHz; 1=freq 25-80 MHz
    fabric_otp_user_din_i                                   	    : in  std_logic_vector((39)-1 downto 0);                       		 --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Input data bus
    fabric_otp_user_prgwidth_i                              	    : in  std_logic_vector((3)-1 downto 0);                        		 --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Set programming pulse with 011 value
    fabric_otp_user_tst_scanin_i                            	    : in  std_logic_vector((5)-1 downto 0);                        		 --SERVICE_OTP		 * ok [FABD]->[OTP_USER] Scan chain inputs
    fabric_otp_user_ack_o                                   	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Operation acknowledgement
    fabric_otp_user_bbad_o                                  	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] BIST result
    fabric_otp_user_bend1_o                                 	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] BIST1 ends
    fabric_otp_user_bend2_o                                 	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] BIST2 ends 
    fabric_otp_user_calibrated_o                            	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] No RINGO, calibrated stays at 0
    fabric_otp_user_ded_o                                   	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Double error detection
    fabric_otp_user_disturbed_o                             	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Indicate if reading conditions are correct
    fabric_otp_user_locked_o                                	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Indicate if word is locked or not 
    fabric_otp_user_progfail_o                              	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Programmation failed
    fabric_otp_user_pwok_o                                  	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] power vdd/vdd1 are in operating range 
    fabric_otp_user_sec_o                                   	    : out std_logic;  	                                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Single error correction
    fabric_otp_user_bist1fail_o                             	    : out std_logic_vector((8)-1 downto 0);                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] BIST1 run results
    fabric_otp_user_bist2fail_o                             	    : out std_logic_vector((7)-1 downto 0);                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] BIST2 run results 
    fabric_otp_user_dout_o                                  	    : out std_logic_vector((41)-1 downto 0);                       		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Output data bus
    fabric_otp_user_flagstate_o                             	    : out std_logic_vector((4)-1 downto 0);                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Informs on the current state of OTP
    fabric_otp_user_startword_o                             	    : out std_logic_vector((16)-1 downto 0);                       		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Parallel output available at otp start
    fabric_otp_user_tst_scanout_o                           	    : out std_logic_vector((5)-1 downto 0);                        		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Scan chain outputs
    fabric_otp_user_wlromout_o                              	    : out std_logic_vector((10)-1 downto 0);                       		 --SERVICE_OTP		 * ok [OTP_USER]->[FABD] Address check
    fabric_clk_bsm_o                                        	    : out std_logic;                                            		 --SERVICE_SYSTEM		 *ok [BSM]->[FABL]
    fabric_clk_otp_o                                        	    : out std_logic;                                            		 --SERVICE_OTP		 *ok [BSM]->[FABL]
    fabric_clk_user0_o                                      	    : out std_logic;                                            		 --SERVICE_SYSTEM		 *ok [BSM]->[FABL]
    fabric_clk_user1_o                                      	    : out std_logic;                                            		 --SERVICE_SYSTEM		 *ok [BSM]->[FABL]
    fabric_io_in_i                                          	    : in  std_logic_vector((35)-1 downto 0);                             --SERVICE_IO		 *ok [FABD]->[BSM]
    fabric_io_oe_i                                          	    : in  std_logic_vector((35)-1 downto 0);                             --SERVICE_IO		 *ok [FABD]->[BSM]
    fabric_io_out_o                                         	    : out std_logic_vector((35)-1 downto 0);                             --SERVICE_IO		 *ok [BSM]->[FABD]
    fabric_user_clk_i                                       	    : in  std_logic;                        	                   		 --SERVICE_USER		 *ok [FABD]->[BSM] Use fabric_user_clk_i
    fabric_user_data_i                                      	    : in  std_logic_vector((32)-1 downto 0);                             --SERVICE_USER		 *ok [FABD]->[BSM]
    fabric_user_data_o                                      	    : out std_logic_vector((32)-1 downto 0);                             --SERVICE_USER		 *ok [BSM]->[FABD]
    fabric_user_write_cycle_o                               	    : out std_logic;  	                                        		 --SERVICE_USER		 *ok [BSM]->[FABD]
    fabric_user_read_cycle_o                                	    : out std_logic;  	                                        		 --SERVICE_USER		 *ok [BSM]->[FABD]
    fabric_cfg_fabric_user_flag_o                           	    : out std_logic;  	                                        		 --SERVICE_USER		 *ok [BSM]->[FABD]
    fabric_cfg_fabric_user_enable_o                         	    : out std_logic;  	                                        		 --SERVICE_USER		 *ok [BSM]->[FABD]
    fabric_direct_data_i                                      	    : in  std_logic_vector((32)-1 downto 0);                             --SERVICE_USER		 *ok [FABD]->[BSM]
    fabric_direct_data_o                                      	    : out std_logic_vector((32)-1 downto 0); 
    fabric_parusr_clk_i                                     	    : in  std_logic;  	                                        		 --SERVICE_PAR_USR		     Use fabric_user_clk_i
    fabric_parusr_enable_i                                  	    : in  std_logic;  	                                        		 --SERVICE_PAR_USR		 *ok [FABD]->[BSM]
    fabric_parusr_cs_i                                      	    : in  std_logic;  	                                        		 --SERVICE_PAR_USR		 *ok [FABD]->[BSM]
