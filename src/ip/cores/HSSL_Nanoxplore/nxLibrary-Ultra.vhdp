-- =================================================================================================
--   Verific MODELS VHDL definition
-- =================================================================================================

library ieee;
use ieee.std_logic_1164.all;

library NX;
use NX.nxPackage.all;

entity VERIFIC_BUF is
   port (
     i      : in    std_logic;
     o      : out   std_logic
   );
end VERIFIC_BUF;
   
architecture Synthesized of VERIFIC_BUF is
begin
   o <= i;
end;

--------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_INV is
port (
  i      : in    std_logic;
  o      : out   std_logic
);
end VERIFIC_INV;

architecture Synthesized of VERIFIC_INV is
begin
    o <= not(i);
end;

--------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_XOR is
port (
  a0     : in    std_logic;
  a1     : in    std_logic;
  o      : out   std_logic
);
end VERIFIC_XOR;

architecture Synthesized of VERIFIC_XOR is
begin
   o <= a0 XOR a1;
end;

--------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_OR is
port (
  a0     : in    std_logic;
  a1     : in    std_logic;
  o      : out   std_logic
);
end VERIFIC_OR;

architecture Synthesized of VERIFIC_OR is
begin
   o <= a0 OR a1;
end;

--------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_AND is
port (
  a0     : in    std_logic;
  a1     : in    std_logic;
  o      : out   std_logic
);
end VERIFIC_AND;

architecture Synthesized of VERIFIC_AND is
begin
   o <= a0 AND a1;
end;

--------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_MUX is
port (
  a0     : in    std_logic;
  a1     : in    std_logic;
  c      : in    std_logic;
  o      : out   std_logic
);
end VERIFIC_MUX;

architecture Synthesized of VERIFIC_MUX is
begin
   o <= a0 when c = '0' else a1 when c = '1' else 'X';
end;

--------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_DFF is
port (
  d            : in    std_logic;
  clk          : in    std_logic;
  async_cond   : in    std_logic;
  async_val    : in    std_logic;
  q            : out   std_logic
);
end VERIFIC_DFF;

architecture Synthesized of VERIFIC_DFF is
   signal s    : std_logic;
   signal r    : std_logic;

begin
   s     <= async_cond and async_val;
   r     <= async_cond and not(async_val);

   process (clk, r, s)
   begin
     if (r = '1') then
       q <= '0';
     else
         if (s = '1') then
            q <= '1';
         else
           q <= d;
         end if;
      end if;
   end process;
end;

