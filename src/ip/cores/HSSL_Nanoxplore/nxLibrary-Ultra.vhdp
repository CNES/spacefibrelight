    EI7	: in std_logic := '0';
    EI8	: in std_logic := '0';
    EL	: in std_logic := '0';
    ER	: in std_logic := '0';
    CI1	: in std_logic := '0';
    CL	: in std_logic := '0';
    CR	: in std_logic := '0';
    RI	: in std_logic := '0';
    RL	: in std_logic := '0';
    RR	: in std_logic := '0';
    CO	: out std_logic;
    CTI	: in std_logic := '0';
    CTO	: out std_logic;
    EO	: out std_logic;
    RO1	: out std_logic;
