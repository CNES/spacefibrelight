library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity ACC92_2DSP is
    generic (
        g_pipe : integer := 2 -- range between [1 - 3]
    );
    port (
        -- Global
        clk : in std_logic := '0';
        rst : in std_logic := '0';
        -- 
        X   : in std_logic_vector(55 downto 0);
        Z   : out std_logic_vector(91 downto 0)
    );
end ACC92_2DSP;

architecture rtl of ACC92_2DSP is

    component NX_DSP_L_WRAP is
        generic (
            std_mode    : string                  := "";
            raw_config0 : bit_vector(19 downto 0) := B"00000000000000000000"; -- Mux
            raw_config1 : bit_vector(18 downto 0) := B"0000000000000000000";    -- Pipe Mux
            raw_config2 : bit_vector(12 downto 0) := B"0000000000000";              -- Pipe Reset
            raw_config3 : bit_vector(6 downto 0)  := B"0000000"                          -- ALU operation
        );
        port (
            A    : in std_logic_vector(23 downto 0);
            B    : in std_logic_vector(17 downto 0);
            C    : in std_logic_vector(35 downto 0);
    
            CAI  : in std_logic_vector(23 downto 0);
            CAO  : out std_logic_vector(23 downto 0);
            CBI  : in std_logic_vector(17 downto 0);
            CBO  : out std_logic_vector(17 downto 0);
    
            CCI  : in std_logic;
            CCO  : out std_logic;
            CI   : in std_logic;
            CK   : in std_logic;
            CO   : out std_logic;
            CO37 : out std_logic;
            CO57 : out std_logic;
    
            CZI  : in std_logic_vector(55 downto 0);
            CZO  : out std_logic_vector(55 downto 0);
    
            D    : in std_logic_vector(17 downto 0);
    
            OVF  : out std_logic;
            R    : in std_logic;
            RZ   : in std_logic;
            WE   : in std_logic;
    
            Z    : out std_logic_vector(55 downto 0)
        );
    end component;

    function raw_config0_0 return bit_vector is
        --constant result : bit_vector(26 downto 0) := "000010000000001001100000000";
        constant result : bit_vector(19 downto 0) := "00000000000010100001";
    begin
        return result;
    end function;
    --
    function raw_config0_1 return bit_vector is
        --constant result : bit_vector(26 downto 0) := "000000000000001011101100001";
        constant result : bit_vector(19 downto 0) := "00000000000110100001";
        --constant result : bit_vector(19 downto 0) := "00000000000010100001";
    begin
        return result;
    end function;
    --

    --
    function raw_config1_0 return bit_vector is
        constant result : bit_vector(18 downto 0) := "0010000000000000000";
    begin
        return result;
    end function;
    function raw_config1_1 return bit_vector is
        constant result : bit_vector(18 downto 0) := "0010000000000000000";
    begin
        return result;
    end function;
    --

    --
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(12 downto 0) := "1010010001111";
    begin
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(12 downto 0) := "1010010001111";
    begin
        return result;
    end function;
    --

    --
    function raw_config3_0 return bit_vector is
        constant result : bit_vector(6 downto 0) := "0000000";
    begin
        return result;
    end function;
    function raw_config3_1 return bit_vector is
        constant result : bit_vector(6 downto 0) := "0000001";
    begin
        return result;
    end function;

    -- input pipes outside dsp
    -- cascade output from one dsp to another
    signal C0 : std_logic;
    -- dsp outputs
    signal Z0 : std_logic_vector(55 downto 0);
    signal Z0_r : std_logic_vector(41 downto 0);
    signal Z1 : std_logic_vector(55 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);
    signal C1 : std_logic_vector(35 downto 0);
    signal D1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);

    signal C2 : std_logic_vector(35 downto 0);
    signal D2 : std_logic_vector(17 downto 0);

    begin

        --A1 <= x(35)&x(35)&x(35)&x(35)&x(35)&x(35)&x(35 downto 18);
        A1 <= "000000"&x(17 downto 0);
        B1 <= x(35 downto 18);

        C1 <= Z0(35 downto 0);
        D1 <= "0000000000"&Z0(41 downto 34);

        --A2(23 downto 1) <= (others => x(55));
        --A2(0) <= x(54);
        --A2 <= (0=>x(54),others=>x(55));
        A2(17 downto 0) <= x(53 downto 36);
        A2(23 downto 18) <= (others => x(53));
        
        --B2 <= x(53 downto 36);
        B2(17 downto 1) <= (others => x(55));
        B2(0) <= x(54);

        C2 <= Z1(35 downto 0);
        D2 <= "0000000000"&Z1(41 downto 34);

        dsp_acc_0 : NX_DSP_L_WRAP
        generic map(
            raw_config0 => raw_config0_0,
            raw_config1 => raw_config1_0,
            raw_config2 => raw_config2_0,
            raw_config3 => raw_config3_0 
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',

            CI   => '0',
            CO   => open,
            A    => A1,
            B    => B1,
            C    => C1,
            --D    => D1,
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => Z0,
            CO37 => C0,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        dsp_acc_1 : NX_DSP_L_WRAP
        generic map(
            raw_config0 => raw_config0_1,
            raw_config1 => raw_config1_1,
            raw_config2 => raw_config2_1,
            raw_config3 => raw_config3_1
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',

            CI   => '0',
            CO   => open,
            A    => A2,
            B    => B2,
            C    => C2,
            --D    => D2,
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => C0,

            Z    => Z1,
            CO37 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        --input_pipe : process (clk)
        --    begin
        --        if rising_edge(clk) then
        --            Z0_r <= Z0(35 downto 0);
        --        end if;
        --    end process input_pipe;
        
        --Z(41 downto 0)  <= Z0_r;
        Z(35 downto 0)  <= Z0(35 downto 0);
        Z(91 downto 36) <= Z1;

end architecture;-- =================================================================================================
--   NX_DSP_L definition                                                                2018/11/30
-- =================================================================================================

library ieee;
use ieee.std_logic_1164.all;

library NX;
use NX.nxPackage.all;

entity NX_DSP_L is
generic (
    std_mode    : string := ""; -- standard mode [ADD36, SUB36, SMUL18, UMUL18, ...] empty for raw
    raw_config0 : bit_vector(19 downto 0) := B"00000000000000000000";   -- MUX
    raw_config1 : bit_vector(18 downto 0) := B"0000000000000000000";    -- PRC
    raw_config2 : bit_vector(12 downto 0) := B"0000000000000";          -- PRR
    raw_config3 : bit_vector( 6 downto 0) := B"0000000"                 -- ALU
);
port (
    A1    : in  std_logic;
    A2    : in  std_logic;
    A3    : in  std_logic;
    A4    : in  std_logic;
    A5    : in  std_logic;
    A6    : in  std_logic;
    A7    : in  std_logic;
    A8    : in  std_logic;
    A9    : in  std_logic;
    A10   : in  std_logic;
    A11   : in  std_logic;
    A12   : in  std_logic;
    A13   : in  std_logic;
    A14   : in  std_logic;
    A15   : in  std_logic;
    A16   : in  std_logic;
    A17   : in  std_logic;
    A18   : in  std_logic;
    A19   : in  std_logic;
    A20   : in  std_logic;
    A21   : in  std_logic;
    A22   : in  std_logic;
    A23   : in  std_logic;
    A24   : in  std_logic;

    B1    : in  std_logic;
    B2    : in  std_logic;
    B3    : in  std_logic;
    B4    : in  std_logic;
    B5    : in  std_logic;
    B6    : in  std_logic;
    B7    : in  std_logic;
    B8    : in  std_logic;
    B9    : in  std_logic;
    B10   : in  std_logic;
    B11   : in  std_logic;
    B12   : in  std_logic;
    B13   : in  std_logic;
    B14   : in  std_logic;
    B15   : in  std_logic;
    B16   : in  std_logic;
    B17   : in  std_logic;
    B18   : in  std_logic;

    C1    : in  std_logic;
    C2    : in  std_logic;
    C3    : in  std_logic;
