    fabric_spi_rst_n_i                                      	    : in  std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		  Fabric access to Flash hardware reset output
    fabric_spi_init_done_o                                  	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		  Fabric SPI init done flag, 0 = init not done,    1 = init done
    fabric_spi_busy_o                                       	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		  Fabric SPI busy flag,      0 = SPI not busy,     1 = SPI busy
    fabric_spi_vcc_used_o                                   	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		  Fabric SPI VCC used flag,  0 = BSM VCC not used, 1 = BSM VCC used
    fabric_spi_error_sel_o                                  	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
    fabric_spi_error_loopback_o                             	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
