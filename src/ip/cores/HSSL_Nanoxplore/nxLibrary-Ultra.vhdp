component NX_ADC_U is
generic (
    location                : string := "";
    cfg_clk_cal_div_ratio_i : integer range 0 to 15:= 0;
    cfg_conv_done_delayed_i : std_logic;
    cfg_use_cdc_i           : std_logic
  );
port (
    --clock
    usr_clk_i	: in std_logic := '0';
    usr_cke_i	: in std_logic := '0';
  
    --reset
    adc_pwr_down_b_tmr_i1	: in std_logic := '0';
    adc_pwr_down_b_tmr_i2	: in std_logic := '0';
    adc_pwr_down_b_tmr_i3	: in std_logic := '0';
    usr_arst_b_tmr_i1	: in std_logic := '0';
    usr_arst_b_tmr_i2	: in std_logic := '0';
    usr_arst_b_tmr_i3	: in std_logic := '0';

    -- CALIBRATION interface
    adc_cal_done_o	: out std_logic;

    cal_p_overflow_o	: out std_logic;
    cal_p_underflow_o	: out std_logic;
    cal_n_overflow_o	: out std_logic;
    cal_n_underflow_o	: out std_logic;

    -- CALIBRATION update interface
    adc_cal_updt_we_i	: in std_logic := '0';
    adc_cal_updt_n_i	: in std_logic := '0';
    adc_cal_updt_val_i1	: in std_logic := '0';
    adc_cal_updt_val_i2	: in std_logic := '0';
    adc_cal_updt_val_i3	: in std_logic := '0';
    adc_cal_updt_val_i4	: in std_logic := '0';
    adc_cal_updt_val_i5	: in std_logic := '0';
    adc_cal_updt_val_i6	: in std_logic := '0';

    -- CONVERSION
    adc_cfg_usr_channel_i1	: in std_logic := '0';
    adc_cfg_usr_channel_i2	: in std_logic := '0';
    adc_cfg_usr_channel_i3	: in std_logic := '0';

    adc_conv_start_i	: in std_logic := '0';
    adc_cfg_free_running_i	: in std_logic := '0';
    adc_free_nb_sample_cycles1	: in std_logic := '0';
    adc_free_nb_sample_cycles2	: in std_logic := '0';
    adc_free_nb_sample_cycles3	: in std_logic := '0';
    adc_free_nb_sample_cycles4	: in std_logic := '0';
    adc_usr_sample_i1	: in std_logic := '0';
    adc_usr_sample_i2	: in std_logic := '0';
    adc_usr_sample_i3	: in std_logic := '0';
    adc_usr_sample_i4	: in std_logic := '0';
    
    adc_conv_done_o	: out std_logic;
    adc_sample_data_o1	: out std_logic;
    adc_sample_data_o2	: out std_logic;
    adc_sample_data_o3	: out std_logic;
    adc_sample_data_o4	: out std_logic;
    adc_sample_data_o5	: out std_logic;
    adc_sample_data_o6	: out std_logic;
    adc_sample_data_o7	: out std_logic;
    adc_sample_data_o8	: out std_logic;
    adc_sample_data_o9	: out std_logic;
    adc_sample_data_o10	: out std_logic;
    adc_sample_data_o11	: out std_logic;
    adc_sample_data_o12	: out std_logic
  );
end component NX_ADC_U;

component NX_ADC_WRAP_U is
generic (
    location                : string := "";
    cfg_clk_cal_div_ratio_i : integer range 0 to 15:= 0;
    cfg_conv_done_delayed_i : std_logic;
    cfg_use_cdc_i           : std_logic
  );
port (
    --clock
    usr_clk_i	: in std_logic := '0';
    usr_cke_i	: in std_logic := '0';
  
    --reset
    adc_pwr_down_b_tmr_i	: in std_logic_vector(2 downto 0) := (others => '0');
    usr_arst_b_tmr_i	: in std_logic_vector(2 downto 0) := (others => '0');

    -- CALIBRATION interface
    adc_cal_done_o	: out std_logic;

    cal_p_overflow_o	: out std_logic;
    cal_p_underflow_o	: out std_logic;
    cal_n_overflow_o	: out std_logic;
    cal_n_underflow_o	: out std_logic;

    -- CALIBRATION update interface
    adc_cal_updt_we_i	: in std_logic := '0';
    adc_cal_updt_n_i	: in std_logic := '0';
    adc_cal_updt_val_i	: in std_logic_vector(5 downto 0) := (others => '0');

    -- CONVERSION
    adc_cfg_usr_channel_i	: in std_logic_vector(2 downto 0) := (others => '0');

    adc_conv_start_i	: in std_logic := '0';
    adc_cfg_free_running_i	: in std_logic := '0';
    adc_free_nb_sample_cycles	: in std_logic_vector(3 downto 0) := (others => '0');
    adc_usr_sample_i	: in std_logic_vector((positive(ceil(log2(real(12)))))-1 downto 0) := (others => '0');
    
    adc_conv_done_o	: out std_logic;
    adc_sample_data_o	: out std_logic_vector(12-1 downto 0)
  );
end component NX_ADC_WRAP_U;

