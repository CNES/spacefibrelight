entity NX_CDC_L_2DFF is 
generic (
  ck0_edge        : bit := '0';
  ck1_edge        : bit := '0';
  ack_sel        : bit := '0';
  bck_sel        : bit := '0';
  use_adest_arst : bit_vector(1 downto 0) := "00";
  use_bdest_arst : bit_vector(1 downto 0) := "00";
  gt0_bypass_reg1 :bit := '0';
  gt0_bypass_reg2 :bit := '0';
  gt1_bypass_reg1 :bit := '0';
  gt1_bypass_reg2 :bit := '0'
);
port (
  CK1    : in  std_logic;
  CK2    : in  std_logic;
  ADRSTI : in  std_logic;
  AI     : in  std_logic_vector(5 downto 0);
  AO     : out std_logic_vector(5 downto 0);
  BDRSTI : in  std_logic;
  BI     : in  std_logic_vector(5 downto 0);
  BO     : out std_logic_vector(5 downto 0)
);
end NX_CDC_L_2DFF;

architecture NX_RTL of NX_CDC_L_2DFF is
    attribute NX_TYPE :string;
    attribute NX_TYPE of NX_RTL: architecture is "WRAPPER";

component NX_CDC_L is
generic (
    mode           : integer := 0;
    ck0_edge        : bit := '0';
    ck1_edge        : bit := '0';
    ack_sel        : bit := '0';
    bck_sel        : bit := '0';
    cck_sel        : bit := '0';
    dck_sel        : bit := '0';
    use_asrc_arst  : bit_vector(1 downto 0) := "00";
    use_adest_arst : bit_vector(1 downto 0) := "00";
    use_bsrc_arst  : bit_vector(1 downto 0) := "00";
    use_bdest_arst : bit_vector(1 downto 0) := "00";
    use_csrc_arst  : bit_vector(1 downto 0) := "00";
    use_cdest_arst : bit_vector(1 downto 0) := "00";
    use_dsrc_arst  : bit_vector(1 downto 0) := "00";
    use_ddest_arst : bit_vector(1 downto 0) := "00";
    gt0_bypass_reg1 :bit := '0';
    gt0_bypass_reg2 :bit := '0';
    gt1_bypass_reg1 :bit := '0';
    gt1_bypass_reg2 :bit := '0';
    link_BA        : bit := '0';
    link_CB        : bit := '0';
    link_DC        : bit := '0'
);
port (
    CK1    : in  std_logic;
    CK2    : in  std_logic;
    --ASRSTI : in  std_logic;
    --ADRSTI : in  std_logic;
    AI1    : in  std_logic;
    AI2    : in  std_logic;
    AI3    : in  std_logic;
    AI4    : in  std_logic;
    AI5    : in  std_logic;
    AI6    : in  std_logic;
    AO1    : out std_logic;
    AO2    : out std_logic;
    AO3    : out std_logic;
    AO4    : out std_logic;
    AO5    : out std_logic;
    AO6    : out std_logic;
    --BSRSTI : in  std_logic;
    --BDRSTI : in  std_logic;
    BI1    : in  std_logic;
    BI2    : in  std_logic;
    BI3    : in  std_logic;
    BI4    : in  std_logic;
    BI5    : in  std_logic;
    BI6    : in  std_logic;
    BO1    : out std_logic;
    BO2    : out std_logic;
    BO3    : out std_logic;
    BO4    : out std_logic;
    BO5    : out std_logic;
    BO6    : out std_logic;
    --CSRSTI : in  std_logic;
    --CDRSTI : in  std_logic;
