    --                                                 53                        0     0->B from core logic ; 1->B from cascade
    --                                                 54                         0    0->A from core logic ; 1->A from cascade
    --                                                 55                          0   pre-adder operation : {0->addition ; 1->substraction}
    --                                                 59                           1  signed mode
    function raw_config0_0 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000010000000001001100000000";
