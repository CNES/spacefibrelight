    fabric_spw1_apb_slv_pwdata_i                            	    : in  std_logic_vector((31)-1 downto 0);                             --SERVICE_SPW(1)		  APB Slave - Write data Bus
    fabric_spw1_apb_slv_prdata_o                            	    : out std_logic_vector((31)-1 downto 0);                             --SERVICE_SPW(1)		  APB Slave - Read data Bus
