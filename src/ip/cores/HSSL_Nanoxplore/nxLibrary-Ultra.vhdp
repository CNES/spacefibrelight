      ,location            => location
      ,dff_type            => dff_type
      ,dff_sync            => dff_sync
      ,dff_load            => dff_load
    )
    port map (
      CK       => CK
      ,CKF     => CK
      ,R       => R
      ,I       => I1
      ,I2      => I2
