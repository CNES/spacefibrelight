      AO5    => AO(4),
      AO6    => AO(5),
      --BSRSTI => '0',
      --BDRSTI => BDRSTI,
      BI1    => BI(0),
      BI2    => BI(1),
      BI3    => BI(2),
      BI4    => BI(3),
      BI5    => BI(4),
      BI6    => BI(5),
      BO1    => BO(0),
      BO2    => BO(1),
      BO3    => BO(2),
      BO4    => BO(3),
      BO5    => BO(4),
      BO6    => BO(5),
      --CSRSTI => '0',
      --CDRSTI => '0',
      CI1    => '0',
      CI2    => '0',
      CI3    => '0',
      CI4    => '0',
      CI5    => '0',
      CI6    => '0',
      CO1    => OPEN,
      CO2    => OPEN,
      CO3    => OPEN,
      CO4    => OPEN,
      CO5    => OPEN,
      CO6    => OPEN,
      --DSRSTI => '0',
      --DDRSTI => '0',
      DI1    => '0',
      DI2    => '0',
      DI3    => '0',
      DI4    => '0',
      DI5    => '0',
      DI6    => '0',
      DO1    => OPEN,
      DO2    => OPEN,
      DO3    => OPEN,
      DO4    => OPEN,
      DO5    => OPEN,
      DO6    => OPEN
    );
end NX_RTL;

