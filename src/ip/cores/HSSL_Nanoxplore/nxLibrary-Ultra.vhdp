library ieee;
use ieee.std_logic_1164.all;

entity VERIFIC_DLATCHRS is
port (
  d            : in    std_logic;
  gate         : in    std_logic;
  s            : in    std_logic;
  r            : in    std_logic;
  q            : out   std_logic
);
end VERIFIC_DLATCHRS;

architecture Synthesized of VERIFIC_DLATCHRS is
begin

   process (gate, r, s, d)
   begin
     if (r = '1') then
       q <= '0';
     else
         if (s = '1') then
            q <= '1';
         else
            if (gate = '1') then
               q <= d;
            end if;
         end if;
      end if;
   end process;
end;

