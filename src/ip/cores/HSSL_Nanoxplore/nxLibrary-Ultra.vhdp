    fabric_spi_error_endianness_o                           	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
    fabric_spi_cmd_push_i                                   	    : in  std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
    fabric_spi_cmd_full_o                                   	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
    fabric_spi_cmd_type_i                                   	    : in  std_logic_vector((3*2)-1 downto 0);                     		 --SERVICE_SPI		 
    fabric_spi_cmd_mode_i                                   	    : in  std_logic_vector((3*2)-1 downto 0);                     		 --SERVICE_SPI		 
    fabric_spi_cmd_bytes_i                                  	    : in  std_logic_vector(24-1 downto 0);                     		 --SERVICE_SPI		 
    fabric_spi_mosi_push_i                                  	    : in  std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
    fabric_spi_mosi_full_o                                  	    : out std_logic_vector((3)-1 downto 0);                       		 --SERVICE_SPI		 
    fabric_spi_mosi_data_i                                  	    : in  std_logic_vector((3*8)-1 downto 0);                     		 --SERVICE_SPI		 
