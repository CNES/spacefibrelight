library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library NX;
use NX.nxPackage.all;

entity NX_PLL_U_BOX is 
  generic (
    location                        : string  := "CKG1";

    cfg_use_pll                     : std_logic;
    cfg_pll_odf                     : std_logic_vector(2-1 downto 0);
    cfg_pll_cpump                   : std_logic_vector(4-1 downto 0);
    cfg_pll_lpf_res                 : std_logic_vector(4-1 downto 0);
    cfg_pll_lpf_cap                 : std_logic_vector(4-1 downto 0);
    cfg_pll_lock                    : std_logic_vector(4-1 downto 0);
    cfg_pll_ldf_div_ratio           : std_logic_vector(7-1 downto 0);
    cfg_pll_clk_ref_div_ratio       : std_logic_vector(5-1 downto 0);
    cfg_pll_clk_ref_mux             : std_logic_vector(3-1 downto 0);
    cfg_pll_clk_fb_mux              : std_logic_vector(3-1 downto 0);
    cfg_pll_clk_fb_add_delay        : std_logic;
    cfg_dly_val_feedback            : std_logic_vector(6-1 downto 0);
    cfg_pll_clk_div_ratio_0         : std_logic_vector(3-1 downto 0);
    cfg_pll_clk_div_ratio_1         : std_logic_vector(3-1 downto 0);
    cfg_pll_clk_div_ratio_2         : std_logic_vector(3-1 downto 0);
    cfg_pll_clk_div_ratio_3         : std_logic_vector(3-1 downto 0);
    cfg_pll_clk_div_dyn_ratio_0     : std_logic_vector(4-1 downto 0);
    cfg_pll_clk_div_dyn_ratio_1     : std_logic_vector(4-1 downto 0);
    cfg_pll_clk_div_dyn_ratio_2     : std_logic_vector(4-1 downto 0);
    cfg_pll_clk_div_dyn_ratio_3     : std_logic_vector(4-1 downto 0);
    cfg_pll_clk_div_dyn_ratio_4     : std_logic_vector(4-1 downto 0);
    cfg_use_cal                     : std_logic;
    cfg_clk_cal_mux                 : std_logic_vector(2-1 downto 0);
    cfg_clk_cal_div_ratio           : std_logic_vector(4-1 downto 0);
    cfg_dly_val_calibration         : std_logic_vector(6-1 downto 0);
    cfg_test_mode                   : std_logic_vector(2-1 downto 0)
    --
    --cfg_wvf_en                      : std_logic;
    --cfg_wvf_clk_mux                 : std_logic_vector(5-1 downto 0);
    --cfg_wvf_clk_inv                 : std_logic;
    --cfg_wvf_sync_mux                : std_logic_vector(4-1 downto 0);
    --cfg_wvf_sync_use_arst_n         : std_logic;
    --cfg_wvf_sync_use_pll_lock       : std_logic;
    --cfg_wvf_sync_use_pll_locka      : std_logic;
    --cfg_wvf_sync_use_cal_lock       : std_logic;
    --cfg_wvf_pattern                 : std_logic_vector(16-1 downto 0);
    --cfg_wvf_pattern_len_max         : std_logic_vector(4-1 downto 0);
    --cfg_wvf_add_delay               : std_logic;
    --cfg_dly_val_waveform            : std_logic_vector(6-1 downto 0)
  );
  port (
    R                 : in std_logic;  -- Reset
    REF               : in std_logic;  -- PLL's reference clock
    FBK               : in std_logic;  -- PLL's feedback clock
    -- Clock
    OSC               : out std_logic; -- Oscillator's clock
    VCO               : out std_logic; -- PLL's output
    LDFO              : out std_logic; -- LDF_DIV
    REFO              : out std_logic; -- REF_DIV
    CLK_DIV1          : out std_logic; -- 1/(N+3)
    CLK_DIV2          : out std_logic; -- 1/(N+5)
    CLK_DIV3          : out std_logic; -- 1/(N+7)
    CLK_DIV4          : out std_logic; -- 1/(N+9)
    CLK_DIVD1         : out std_logic; -- 1/(N+2)
    CLK_DIVD2         : out std_logic; -- 1/(N+2)
    CLK_DIVD3         : out std_logic; -- 1/(N+2)
    CLK_DIVD4         : out std_logic; -- 1/(N+2)
    CLK_DIVD5         : out std_logic; -- 1/(N+2)
    -- Lock engine
    PLL_LOCKED        : out std_logic;
    PLL_LOCKEDA       : out std_logic;
    -- Calbration
    ARST_CAL          : in std_logic;  -- calibration's reset
    CLK_CAL           : in std_logic;  -- Calibration's clock
    CLK_CAL_DIV       : out std_logic; -- Output of calibration clock's divider
    CAL_LOCKED        : out std_logic;
    EXT_CAL_LOCKED    : in std_logic;
    CAL1              : out std_logic;
    CAL2              : out std_logic;
    CAL3              : out std_logic;
    CAL4              : out std_logic;
    CAL5              : out std_logic;
    EXT_CAL1          : in std_logic;
    EXT_CAL2          : in std_logic;
    EXT_CAL3          : in std_logic;
    EXT_CAL4          : in std_logic;
    EXT_CAL5          : in std_logic;
    DYN_CFG_EN        : in std_logic;
    DYN_CFG_CS_N1     : in std_logic;
    DYN_CFG_CS_N2     : in std_logic;
    DYN_CFG_CS_N3     : in std_logic;
    DYN_CFG_WE_N      : in std_logic;
    DYN_CFG_ADDR1     : in std_logic;
    DYN_CFG_ADDR2     : in std_logic;
    DYN_CFG_ADDR3     : in std_logic;
    DYN_CFG_ADDR4     : in std_logic;
    DYN_CFG_WDATA_SEL : in std_logic;
    DYN_CFG_WDATA1    : in std_logic;
    DYN_CFG_WDATA2    : in std_logic;
    DYN_CFG_WDATA3    : in std_logic;
    DYN_CFG_WDATA4    : in std_logic;
    DYN_CFG_WDATA5    : in std_logic;
    DYN_CFG_WDATA6    : in std_logic;
    DYN_CFG_WDATA7    : in std_logic;
    DYN_CFG_RDATA1    : in std_logic;
    DYN_CFG_RDATA2    : in std_logic;
    DYN_CFG_RDATA3    : in std_logic;
    DYN_CFG_RDATA4    : in std_logic;
    DYN_CFG_RDATA5    : in std_logic;
    DYN_CFG_RDATA6    : in std_logic;
    DYN_CFG_RDATA7    : in std_logic;
    scan_en_i         : in std_logic;
    scan_in_i1        : in std_logic;
    scan_in_i2        : in std_logic;
    scan_in_i3        : in std_logic;
    scan_in_i4        : in std_logic;
    scan_in_i5        : in std_logic;
    scan_in_i6        : in std_logic;
    scan_in_i7        : in std_logic;
    scan_in_i8        : in std_logic;
    scan_in_i9        : in std_logic;
    scan_in_i10       : in std_logic;
    scan_in_i11       : in std_logic;
    scan_in_i12       : in std_logic;
    scan_in_i13       : in std_logic;
    scan_in_i14       : in std_logic;
    scan_in_i15       : in std_logic;
    scan_in_i16       : in std_logic;
    scan_in_i17       : in std_logic;
    scan_in_i18       : in std_logic;
    scan_in_i19       : in std_logic;
    scan_in_i20       : in std_logic;
    scan_in_i21       : in std_logic;
    scan_in_i22       : in std_logic;
    scan_in_i23       : in std_logic;
    scan_in_i24       : in std_logic;
    scan_in_i25       : in std_logic;
    scan_in_i26       : in std_logic;
    scan_in_i27       : in std_logic;
    scan_in_i28       : in std_logic;
    scan_in_i29       : in std_logic;
    scan_in_i30       : in std_logic;
    scan_in_i31       : in std_logic;
    scan_in_i32       : in std_logic;
    scan_in_i33       : in std_logic;
    scan_in_i34       : in std_logic;
    scan_in_i35       : in std_logic;
    scan_in_i36       : in std_logic;
    scan_in_i37       : in std_logic;
    scan_out_o1       : in std_logic;
    scan_out_o2       : in std_logic;
    scan_out_o3       : in std_logic;
    scan_out_o4       : in std_logic;
    scan_out_o5       : in std_logic;
    scan_out_o6       : in std_logic;
    scan_out_o7       : in std_logic;
    scan_out_o8       : in std_logic;
    scan_out_o9       : in std_logic;
    scan_out_o10      : in std_logic;
    scan_out_o11      : in std_logic;
    scan_out_o12      : in std_logic;
    scan_out_o13      : in std_logic;
    scan_out_o14      : in std_logic;
    scan_out_o15      : in std_logic;
    scan_out_o16      : in std_logic;
    scan_out_o17      : in std_logic;
    scan_out_o18      : in std_logic;
    scan_out_o19      : in std_logic;
    scan_out_o20      : in std_logic;
    scan_out_o21      : in std_logic;
    scan_out_o22      : in std_logic;
    scan_out_o23      : in std_logic;
    scan_out_o24      : in std_logic;
    scan_out_o25      : in std_logic;
    scan_out_o26      : in std_logic;
    scan_out_o27      : in std_logic;
    scan_out_o28      : in std_logic;
