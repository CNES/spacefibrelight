    fabric_thsens_fm_config_r_o                             	    : out std_logic_vector((27)-1 downto 0);                       		 --SERVICE_VTSENS		  read config {trimvbe, curvature, dcorrect, pivot, meanfilter; datarate}
    fabric_thsens_clk_div_ratio_i                           	    : in  std_logic_vector((8)-1 downto 0);                        		 --SERVICE_VTSENS
