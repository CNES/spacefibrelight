    tx0n	: out std_logic;
    tx0p	: out std_logic;
    tx1n	: out std_logic;
    tx1p	: out std_logic;
    tx2n	: out std_logic;
    tx2p	: out std_logic;
    tx3n	: out std_logic;
    tx3p	: out std_logic;

    pll_ckref_in	: in std_logic := '0';
    pll_ckref_out	: out std_logic;
   
    pma_pll_fbr_clk_ref_o	: out std_logic
);
end component NX_HSSL_U_SPLIT;


end nxPackage;
