    fabric_parusr_data_i                                    	    : in  std_logic_vector((16)-1 downto 0);                       		 --SERVICE_PAR_USR		 *ok [FABD]->[BSM]
    fabric_parusr_data_o                                    	    : out std_logic_vector((16)-1 downto 0);                       		 --SERVICE_PAR_USR		 *ok [BSM]->[FABD]
    fabric_parusr_data_val_o                                	    : out std_logic;  	                                        		 --SERVICE_PAR_USR		 *ok [BSM]->[FABD]
    fabric_jtag_tck_o                                       	    : out std_logic;  	                                        		 --SERVICE_JTAG		     [BSM]->[FABL] JTAG Clock
    fabric_jtag_trst_n_o                                    	    : out std_logic;  	                                        		 --SERVICE_JTAG		 *ok [BSM]->[FABD]
