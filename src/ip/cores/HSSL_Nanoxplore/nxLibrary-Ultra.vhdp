    fabric_spw0_clk_tx_i                                    	    : in  std_logic;                                            		 --SERVICE_SPW(0)		  Clock TX
    fabric_spw0_rst_n_i                                     	    : in  std_logic;                                            		 --SERVICE_SPW(0)		  Reset_n
    fabric_spw0_user_shared_o                               	    : out std_logic;                                            		 --SERVICE_SPW(0)		  Spacewire controller is in shared between BSM and Fabric
    fabric_spw0_tx_fifo_write_i                             	    : in  std_logic;                                            		 --SERVICE_SPW(0)		  write fifo
    fabric_spw0_tx_fifo_data_i                              	    : in  std_logic_vector((9)-1 downto 0);                       		 --SERVICE_SPW(0)		  data to Tx FIFO
    fabric_spw0_tx_fifo_full_o                              	    : out std_logic;  	                                        		 --SERVICE_SPW(0)		  full flag
    fabric_spw0_rx_fifo_read_i                              	    : in  std_logic;  	                                        		 --SERVICE_SPW(0)		  Rx FIFO read
    fabric_spw0_rx_fifo_empty_o                             	    : out std_logic;  	                                        		 --SERVICE_SPW(0)		  empty flag
    fabric_spw0_rx_fifo_data_o                              	    : out std_logic_vector((9)-1 downto 0);                        		 --SERVICE_SPW(0)		  data from Rx FIFO
    fabric_spw0_tick_ctm_i                                  	    : in  std_logic;  	                                        		 --SERVICE_SPW(0)		  time code to send
    fabric_spw0_tick_ctm_o                                  	    : out std_logic;  	                                        		 --SERVICE_SPW(0)		  good time code received
    fabric_spw0_apb_slv_psel_i                              	    : in  std_logic;  	                                        		 --SERVICE_SPW(0)		  APB Slave - Slave select
    fabric_spw0_apb_slv_penable_i                           	    : in  std_logic;  	                                        		 --SERVICE_SPW(0)		  APB Slave - Strobe
    fabric_spw0_apb_slv_paddr_i                             	    : in  std_logic_vector((6) downto 2);                            	 --SERVICE_SPW(0)		  APB Slave - Address bus (byte)
    fabric_spw0_apb_slv_pwrite_i                            	    : in  std_logic;                              	               		 --SERVICE_SPW(0)		  APB Slave - Write
    fabric_spw0_apb_slv_pwdata_i                            	    : in  std_logic_vector((31)-1 downto 0);                           	 --SERVICE_SPW(0)		  APB Slave - Write data Bus
    fabric_spw0_apb_slv_prdata_o                            	    : out std_logic_vector((31)-1 downto 0);                           	 --SERVICE_SPW(0)		  APB Slave - Read data Bus
    fabric_spw0_apb_slv_pready_o                            	    : out std_logic;  	                                        		 --SERVICE_SPW(0)		  APB Slave - Ready
