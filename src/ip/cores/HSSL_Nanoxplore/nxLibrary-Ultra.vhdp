library ieee;
use ieee.std_logic_1164.all;

entity GENERIC_DFF is
generic (
    dff_edge   : bit       := '0';
    dff_init   : bit       := '0';
    dff_load   : bit       := '0';
    dff_sync   : bit       := '0';
    dff_type   : bit       := '0';
    dff_ctxt   : std_logic := 'U'
);
port (
    clk : in  std_logic;
    d   : in  std_logic;
    le  : in  std_logic;
    q   : out std_logic;
    rst : in  std_logic
);
end GENERIC_DFF;

architecture NX_SIMU of GENERIC_DFF is
  signal mem_ren       : std_logic;
  signal mem_cen       : std_logic;
  signal mem_auxIn     : std_logic;
  signal mem_auxOut    : std_logic;
  signal mem_sync      : std_logic;
  signal mem_combi     : std_logic;
  signal mem_posedge   : std_logic;
  signal mem_DontCare0 : std_logic;
  signal clk_int       : std_logic;
  signal async_rst     : std_logic;
  signal sync_rst      : std_logic;
  signal rst_sel       : std_logic;
  signal enable        : std_logic;
  signal i_int         : std_logic;
  signal dff_int       : std_logic register := dff_ctxt;

begin

  mem_posedge <= not(To_StdULogic(dff_edge));
  mem_ren     <=     To_StdULogic(dff_init);
  mem_cen     <=     To_StdULogic(dff_load);
  mem_sync    <=     To_StdULogic(dff_sync);
  clk_int <= clk when mem_posedge = '1' else not(clk);
  rst_sel <= rst when mem_ren = '1' else '0';
  enable  <= le  when mem_cen = '1' else '1';
  async_rst <= '0' when mem_sync = '1' else rst_sel;
  sync_rst  <= rst_sel;
  i_int <= d after 0 ps;

  process (clk_int, async_rst)
  begin
    if (async_rst = '1') then
      dff_int <= To_StdULogic(dff_type);
    else
      if (rising_edge(clk_int)) then
        if (sync_rst = '1') then
          dff_int <= To_StdULogic(dff_type) after 0 ps;
        else
          if (enable = '1') then
            dff_int <= i_int after 0 ps;
          end if;
        end if;
      end if;
    end if;
  end process;

  q <=  dff_int after 0 ps;
end NX_SIMU;
