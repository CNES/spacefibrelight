            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A4_r,
            B    => B4_r,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade_Z2toZ3,
            CCI  => '0',

            Z    => Z3,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        input_pipe : process (clk)
        begin
            if rising_edge(clk) then
                A4_r <= A4;
                B4_r <= B4;
            end if;
        end process input_pipe;

        output_pipe : process (clk)
        begin
            if rising_edge(clk) then
                Z0_r    <= Z0(16 downto 0);
                Z0_r1   <= Z0_r;
                Z0_r2   <= Z0_r1;
                Z1_r    <= Z1(5 downto 0);
                Z1_r1   <= Z1_r;
                Z2_r    <= Z2(16 downto 0);
            end if;
        end process output_pipe;


    
    Z(16 downto 0)  <= Z0_r2;
    Z(22 downto 17) <= Z1_r1;
    Z(39 downto 23) <= Z2_r;
    Z(80 downto 40) <= Z3(40 downto 0);

