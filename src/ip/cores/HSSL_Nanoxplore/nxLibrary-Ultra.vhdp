    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        constant pipe0 : bit_vector(23 downto 0) := "000000000000000000000000";
        constant pipe1 : bit_vector(23 downto 0) := "000000000000000000010001";
        constant pipe2 : bit_vector(23 downto 0) := "000000000100000000010001";
        constant pipe3 : bit_vector(23 downto 0) := "000000000100000000110011";
        constant pipe4 : bit_vector(23 downto 0) := "000000000100100000110011";
    begin
        if g_pipe = 1 then
            return pipe0;
        elsif g_pipe = 2 then
            return pipe1;
        elsif g_pipe = 3 then
            return pipe2;
        elsif g_pipe = 4 then
            return pipe3;
        else
            return pipe3;
        end if;
    end function;
    function raw_config1_1 return bit_vector is
        constant pipe0 : bit_vector(23 downto 0) := "000000010000000000000000";
        constant pipe1 : bit_vector(23 downto 0) := "000000010000000000010001";
        constant pipe2 : bit_vector(23 downto 0) := "000000010100000000010001";
        constant pipe3 : bit_vector(23 downto 0) := "000000010100000000110011";
        constant pipe4 : bit_vector(23 downto 0) := "000000010100100000110011";
