library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library NX;
use NX.nxPackage.all;

entity NX_WFG_U is
    generic (
        location             : string := "";
        wfg_edge             : bit                   := '0'; -- 0: no invert / Rising
        reset_on_pll_lock_n  : bit                   := '0';
        reset_on_pll_locka_n : bit                   := '0';
        reset_on_cal_lock_n  : bit                   := '0';

        mode                 : integer range 0 to 2     := 0;                                   -- 0: no pattern - 1: pattern - 2: diviseur
        pattern              : bit_vector(0 to 15)      := b"0000000000000000"; -- pattern p0 ... p15
        pattern_end          : integer range 0 to 15    := 0;                   -- max pattern length. Set to 0 to use divider/bypass instead of pattern
        div_ratio            : integer range 0 to 1023  := 0;                   -- divisor ratio
        div_phase            : bit                      := '0';                   -- divisor phase
        delay_on             : bit                      := '0';                 -- 0: no delay - 1: delay
        delay                : integer range 0 to 63    := 0                    -- 0 to 63 (1 unit to 32 unit)
    );
    port (
        R  : in std_logic;
        SI : in std_logic;
        ZI : in std_logic;
        SO : out std_logic;
        ZO : out std_logic
    );
end NX_WFG_U;
---------------------------------------------
--
-- NX_WFG_U_FULL.vhd
--
---------------------------------------------

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library NX;
use NX.nxPackage.all;

entity NX_WFG_U_FULL is
    generic (
        location                : string  := "CKG1:WFG.WFG_C1";
        --
        CFG_WVF                 : std_logic_vector(41 downto 0)
    );
    port (
        arst_wvf_i              : in  std_logic;
        sync_wvf                : in  std_logic;
        clk_selected            : in  std_logic;
        sync_o                  : out std_logic;
        clk_out_o               : out std_logic
    );
end NX_WFG_U_FULL;

architecture NX_PROD of NX_WFG_U_FULL is

component NX_WFG_U_BOX is 
  generic (
    location                : string  := "CKG1:WFG.WFG_C1";
    --
    cfg_wvf_en                      : std_logic;
    cfg_wvf_clk_mux                 : std_logic_vector(5-1 downto 0);
    cfg_wvf_clk_inv                 : std_logic;
    cfg_wvf_sync_mux                : std_logic_vector(4-1 downto 0);
    cfg_wvf_sync_use_arst_n         : std_logic;
    cfg_wvf_sync_use_pll_lock       : std_logic;
    cfg_wvf_sync_use_pll_locka      : std_logic;
    cfg_wvf_sync_use_cal_lock       : std_logic;
    cfg_wvf_pattern                 : std_logic_vector(16-1 downto 0);
    cfg_wvf_pattern_len_max         : std_logic_vector(4-1 downto 0);
    cfg_wvf_add_delay               : std_logic;
    cfg_dly_val_waveform            : std_logic_vector(6-1 downto 0)
  );
  port (
    R                               : in std_logic;
    SI                              : in std_logic;
    ZI                              : in std_logic;
    SO                              : out std_logic;
    ZO                              : out std_logic
  );
end component;

attribute syn_preserve : boolean;
attribute syn_preserve of inst_wfg_u : label is true;

begin 

inst_wfg_u : NX_WFG_U_BOX
generic map (
    location                        => location
    --
    ,cfg_wvf_en                      => CFG_WVF(0)
    ,cfg_wvf_clk_mux                 => "01101" --CFG_WVF(5 downto 1)
    ,cfg_wvf_clk_inv                 => CFG_WVF(6)
    ,cfg_wvf_sync_mux                => "0000" --CFG_WVF(10 downto 7)
    ,cfg_wvf_sync_use_arst_n         => CFG_WVF(11)
    ,cfg_wvf_sync_use_pll_lock       => CFG_WVF(12)
    ,cfg_wvf_sync_use_pll_locka      => CFG_WVF(13)
    ,cfg_wvf_sync_use_cal_lock       => CFG_WVF(14)
    ,cfg_wvf_pattern                 => CFG_WVF(30 downto 15)
    ,cfg_wvf_pattern_len_max         => CFG_WVF(34 downto 31)
    ,cfg_wvf_add_delay               => CFG_WVF(35)
    ,cfg_dly_val_waveform            => CFG_WVF(41 downto 36)
    )
port map (
    R                                => arst_wvf_i
    ,SI                              => sync_wvf
    ,ZI                              => clk_selected
    ,SO                              => sync_o
    ,ZO                              => clk_out_o
);

end NX_PROD;
