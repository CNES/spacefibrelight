    DI2    : in  std_logic;
    DI3    : in  std_logic;
    DI4    : in  std_logic;
    DI5    : in  std_logic;
    DI6    : in  std_logic;
    DO1    : out std_logic;
    DO2    : out std_logic;
    DO3    : out std_logic;
    DO4    : out std_logic;
    DO5    : out std_logic;
    DO6    : out std_logic
);
end component;

